{
  "version": "v1.0",
  "created_at": "2026-11-11",
  "programme": "维点图书馆 FLCA-6 · L0.5 规则层",
  "design_note": "D2-b 专家介入后置，规则层承担破读/通假/专名的第一道判音职责。每条规则必须可溯源、可审计、可版本化。pattern 为正则，作用在目标字前后 12 字的句窗上；脚本以『surface 在匹配串中的相对位置』定位目标字。",
  "priority_policy": "同一位置命中多条规则时取 priority 最大者；priority 相同则取 rule_key 字典序靠前者，并记录冲突日志。",
  "rules": [
    {"rule_key":"poDu.wei.prep_for","surface":"为","reading":"wèi","reading_type":"poDu","pattern":"为(?=[民人国君亲己之我尔][^，。；：！？]{0,4}(?:而|以|则|者|也|乎|焉))","priority":70,"authority":"zhuben","source_ref":"《广韵》寘韵于伪切；杨伯峻《论语译注》介詞『為』读去声","note":"介词『为+对象+动词』"},
    {"rule_key":"poDu.wei.verb_zuo","surface":"为","reading":"wéi","reading_type":"poDu","pattern":"(?:以为|作为|为人|为政|为国以礼|无为|有为)","priority":75,"authority":"zhuben","source_ref":"《广韵》支韵薳支切；《论语·为政》","note":"动词『做/成为/治理』"},
    {"rule_key":"poDu.wang.verb_tianxia","surface":"王","reading":"wàng","reading_type":"poDu","pattern":"王(?=天下|之|诸侯|者|此|其|不王)","priority":85,"authority":"zhuben","source_ref":"《孟子·梁惠王上》『德何如则可以王矣』；《广韵》漾韵于放切","note":"名词转动词『称王/王天下』"},
    {"rule_key":"poDu.wang.verb_buwang","surface":"王","reading":"wàng","reading_type":"poDu","pattern":"(?:不|欲|能|可以|足以)王(?!者|天下)","priority":86,"authority":"zhuben","source_ref":"《孟子》『然而不王者，未之有也』","note":"助动词后的『王』为动词"},
    {"rule_key":"poDu.zhong.verb_hit","surface":"中","reading":"zhòng","reading_type":"poDu","pattern":"(?<![其之此是])中(?=之|节|规|伤|计|意|选|举|鹄|程|矢|目|理|肯|綮|风|暑|毒|酒|恶)","priority":70,"authority":"zhuben","source_ref":"《庄子·养生主》『合于桑林之舞，乃中经首之会』；《广韵》送韵陟仲切","note":"动词『射中/切中/遭受』"},
