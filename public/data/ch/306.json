{"id":306,"workId":5,"workTitle":"诗经","title":"詩經/載驅","ord":105,"ordGroup":"齊","chars":125,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧齊‧載驅"},{"t":"p","x":"載驅薄薄，簟茀朱鞹。魯道有蕩，齊子發夕。"},{"t":"p","x":"四驪濟濟，垂轡濔濔。魯道有蕩，齊子豈弟。"},{"t":"p","x":"汶水湯湯，行人彭彭。魯道有蕩，齊子翱翔。"},{"t":"p","x":"汶水滔滔，行人儦儦。魯道有蕩，齊子遊敖。"},{"t":"p","x":"《載驅》，四章，章四句。"}]}