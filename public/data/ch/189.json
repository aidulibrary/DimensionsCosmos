{"id":189,"workId":5,"workTitle":"诗经","title":"詩經/江有汜","ord":22,"ordGroup":"召南","chars":453,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧召南‧江有汜"},{"t":"h","l":3,"x":"齊詩說"},{"t":"p","x":"江水汜沱，思附君子，伯仲爰歸，不我肯顧，侄娣恨悔。"},{"t":"h","l":3,"x":"毛詩序"},{"t":"p","x":"《江有汜》，美媵也。勤而無怨，嫡能悔過也。文王之時，江沱之閒，有嫡不以其媵備數，媵遇勞而無怨。嫡亦自悔也。"},{"t":"h","l":3,"x":"江有汜"},{"t":"p","x":"《江有汜》，三章，章五句。"}]}