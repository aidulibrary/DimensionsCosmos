{"id":242,"workId":5,"workTitle":"诗经","title":"詩經/祈父","ord":191,"ordGroup":"鴻鴈之什","chars":136,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"小雅‧鴻鴈之什‧祈父"},{"t":"p","x":"毛詩序：「《祈父》，刺宣王也。」"},{"t":"h","l":3,"x":"祈父"},{"t":"p","x":"祈父！予王之爪牙，胡轉予于恤？靡所止居。"},{"t":"p","x":"祈父！予王之爪士，胡轉予于恤？靡所厎止。"},{"t":"p","x":"祈父！亶不聦，胡轉予于恤？有母之尸饔。"},{"t":"p","x":"《祈父》，三章，章四句。"}]}