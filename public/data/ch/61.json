{"id":61,"workId":5,"workTitle":"诗经","title":"詩經/兔罝","ord":7,"ordGroup":"周南","chars":361,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧周南‧兔罝"},{"t":"h","l":3,"x":"韓詩說"},{"t":"p","x":"殷紂之賢人退處山林，網禽獸而食之。文王舉閎夭、泰顛於罝網之中。"},{"t":"h","l":3,"x":"毛詩序"},{"t":"p","x":"《兔罝》，后妃之化也。關雎之化行，則莫不好德，賢人衆多也。"},{"t":"h","l":3,"x":"詩文"},{"t":"p","x":"《兔罝》，三章，章四句。"}]}