{"id":124,"workId":5,"workTitle":"诗经","title":"詩經/思文","ord":281,"ordGroup":"周頌清廟","chars":118,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"周頌‧清廟之什‧思文"},{"t":"p","x":"毛詩序：「《思文》，后稷配天也。」"},{"t":"h","l":3,"x":"思文"},{"t":"p","x":"思文后稷，克配彼天。立我烝民，莫匪爾極。"},{"t":"p","x":"貽我來牟，帝命率育，無此疆爾界，陳常于時夏。"},{"t":"p","x":"《思文》，一章，八句。"}]}