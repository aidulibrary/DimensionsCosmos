{"id":13220,"workId":106,"workTitle":"二十四诗品","title":"二十四诗品/沉著","ord":4,"ordGroup":"","chars":71,"quality":"ok","qualityNote":null,"blocks":[{"t":"p","x":"绿林①野室，落日气清，脱巾独步，时闻鸟声。"},{"t":"p","x":"鸿雁不来，之子远行，所思不远，若为平生。"},{"t":"p","x":"海风碧云，夜渚月明。如有佳语，大河前横。"},{"t":"p","x":"①他本多作“绿杉”。"}],"ref":"dc:xb61a5c80/c004"}