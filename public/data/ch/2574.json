{"id":2574,"workId":9,"workTitle":"左传","title":"左传·庄公三年","ord":32,"ordGroup":"","chars":136,"quality":"ok","qualityNote":null,"blocks":[{"t":"p","x":"【经】"},{"t":"p","x":"三年春，王正月，溺会齐师伐卫。"},{"t":"p","x":"夏四月，葬宋庄公。"},{"t":"p","x":"五月，葬桓王。"},{"t":"p","x":"秋，纪季以酅入于齐。"},{"t":"p","x":"冬，公次于滑。"},{"t":"p","x":"【传】"},{"t":"p","x":"三年春，溺会齐师伐卫，疾之也。"},{"t":"p","x":"夏五月，葬桓王，缓也。"},{"t":"p","x":"秋，纪季以酅入于齐，纪于是乎始判。"},{"t":"p","x":"冬，公次于滑，将会郑伯谋纪故也。郑伯辞以难。凡师一宿为舍，再宿为信，过信为次。"}]}