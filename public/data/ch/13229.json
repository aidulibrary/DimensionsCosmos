{"id":13229,"workId":106,"workTitle":"二十四诗品","title":"二十四诗品/精神","ord":13,"ordGroup":"","chars":70,"quality":"ok","qualityNote":null,"blocks":[{"t":"p","x":"欲反不尽，相期与来，明漪绝底，奇花初胎。"},{"t":"p","x":"青春鹦鹉，杨柳楼①台，碧山人来，清酒满杯。"},{"t":"p","x":"生气远出，不著死灰，妙造自然，伊谁与裁。"},{"t":"p","x":"①他本多作“池”。"}],"ref":"dc:xb61a5c80/c013"}