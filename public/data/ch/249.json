{"id":249,"workId":5,"workTitle":"诗经","title":"詩經/絲衣","ord":298,"ordGroup":"周頌閔予","chars":134,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"周頌‧閔予小子之什‧絲衣"},{"t":"p","x":"毛詩序：「《絲衣》，繹賓尸也。高子曰：『靈星之尸也。』」"},{"t":"h","l":3,"x":"絲衣"},{"t":"p","x":"絲衣其紑，載弁俅俅。自堂徂基，自羊徂牛。"},{"t":"p","x":"鼐鼎及鼒，兕觥其觩。旨酒思柔。不吳不敖，胡考之休。"},{"t":"p","x":"《絲衣》，一章，九句。"}]}