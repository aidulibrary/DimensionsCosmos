{"id":246,"workId":5,"workTitle":"诗经","title":"詩經/素冠","ord":147,"ordGroup":"檜","chars":132,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧檜‧素冠"},{"t":"p","x":"毛詩序：「《素冠》，刺不能三年也。」"},{"t":"h","l":3,"x":"素冠"},{"t":"p","x":"庶見素冠兮，棘人欒欒兮，勞心慱慱兮。"},{"t":"p","x":"庶見素衣兮，我心傷悲兮，聊與子同歸兮。"},{"t":"p","x":"庶見素韠兮，我心蘊結兮，聊與子如一兮。"},{"t":"p","x":"《素冠》，三章，章三句。"}]}