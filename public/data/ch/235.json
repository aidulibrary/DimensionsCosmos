{"id":235,"workId":5,"workTitle":"诗经","title":"詩經/盧令","ord":103,"ordGroup":"齊","chars":130,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧齊‧盧令"},{"t":"p","x":"毛詩序：「《盧令》，刺荒也。襄公好田獵，畢弋，而不脩民事。百姓苦之，故陳古以風焉。」"},{"t":"h","l":3,"x":"盧令"},{"t":"p","x":"盧令令，其人美且仁。"},{"t":"p","x":"盧重環，其人美且鬈。"},{"t":"p","x":"盧重鋂，其人美且偲。"},{"t":"p","x":"《盧令》，三章，章二句。"}]}