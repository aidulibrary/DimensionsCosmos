{"id":210,"workId":5,"workTitle":"诗经","title":"詩經/無將大車","ord":212,"ordGroup":"谷風之什","chars":148,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"小雅‧谷風之什‧無將大車"},{"t":"p","x":"毛詩序：「《無將大車》，大夫悔將小人也。」"},{"t":"h","l":3,"x":"無將大車"},{"t":"p","x":"無將大車，祇自塵兮。無思百憂，祇自疷兮。"},{"t":"p","x":"無將大車，維塵冥冥。無思百憂，不出于熲。"},{"t":"p","x":"無將大車，維塵雍兮。無思百憂，祇自重兮。"},{"t":"p","x":"《無將大車》，三章，章四句。"}]}