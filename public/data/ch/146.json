{"id":146,"workId":5,"workTitle":"诗经","title":"詩經/昊天有成命","ord":277,"ordGroup":"周頌清廟","chars":126,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"周頌‧清廟之什‧昊天有成命"},{"t":"p","x":"毛詩序：「《昊天有成命》，郊祀天地也。」"},{"t":"h","l":3,"x":"昊天有成命"},{"t":"p","x":"昊天有成命，二后受之。"},{"t":"p","x":"成王不敢康，夙夜基命宥密。"},{"t":"p","x":"於緝熙！單厥心。肆其靖之。"},{"t":"p","x":"《昊天有成命》，一章，七句。"}]}