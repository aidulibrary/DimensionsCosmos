{"id":149,"workId":5,"workTitle":"诗经","title":"詩經/月出","ord":143,"ordGroup":"陳","chars":145,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧陳‧月出"},{"t":"p","x":"毛詩序：「《月出》，刺好色也。在位不好德而說美色焉。」"},{"t":"h","l":3,"x":"月出"},{"t":"p","x":"月出皎兮，佼人僚兮，舒窈糾兮，勞心悄兮。"},{"t":"p","x":"月出皓兮，佼人懰兮，舒懮受兮，勞心慅兮。"},{"t":"p","x":"月出照兮，佼人燎兮，舒夭紹兮，勞心慘兮。"},{"t":"p","x":"《月出》，三章，章四句。"}]}