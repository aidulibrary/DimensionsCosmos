{"id":273,"workId":5,"workTitle":"诗经","title":"詩經/著","ord":98,"ordGroup":"齊","chars":141,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧齊‧著"},{"t":"p","x":"毛詩序：「《著》，刺時也。時不親迎也。」"},{"t":"h","l":3,"x":"著"},{"t":"p","x":"俟我於著乎而，充耳以素乎而，尚之以瓊華乎而。"},{"t":"p","x":"俟我於庭乎而，充耳以青乎而，尚之以瓊瑩乎而。"},{"t":"p","x":"俟我於堂乎而，充耳以黃乎而，尚之以瓊英乎而。"},{"t":"p","x":"《著》，三章，章三句。"}]}