{"id":217,"workId":5,"workTitle":"诗经","title":"詩經/狡童","ord":86,"ordGroup":"鄭","chars":156,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧鄭‧狡童"},{"t":"p","x":"毛詩序：「《狡童》，刺忽也。不能與賢人圖事，權臣擅命也。」"},{"t":"h","l":3,"x":"狡童"},{"t":"p","x":"彼狡童兮，不與我言兮，維子之故，使我不能餐兮。"},{"t":"p","x":"彼狡童兮，不與我食兮，維子之故，使我不能息兮。"},{"t":"p","x":"《狡童》，二章，章四句。"}]}