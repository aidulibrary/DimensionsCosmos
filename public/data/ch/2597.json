{"id":2597,"workId":9,"workTitle":"左传","title":"左传·庄公二十六年","ord":55,"ordGroup":"","chars":98,"quality":"ok","qualityNote":null,"blocks":[{"t":"p","x":"【经】"},{"t":"p","x":"二十有六年春，公伐戎。"},{"t":"p","x":"夏，公至自伐戎。"},{"t":"p","x":"曹杀其大夫。"},{"t":"p","x":"秋，公会宋人、齐人伐徐。"},{"t":"p","x":"冬十有二月癸亥朔，日有食之。"},{"t":"p","x":"【传】"},{"t":"p","x":"二十六年春，晋士蒍为大司空。"},{"t":"p","x":"夏，士蒍城绛，以深其宫。"},{"t":"p","x":"秋，虢人侵晋。"},{"t":"p","x":"冬，虢人又侵晋。"}]}