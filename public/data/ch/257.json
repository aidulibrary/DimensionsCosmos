{"id":257,"workId":5,"workTitle":"诗经","title":"詩經/羔羊","ord":18,"ordGroup":"召南","chars":379,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧召南‧羔羊"},{"t":"h","l":3,"x":"齐诗说"},{"t":"p","x":"羔羊皮革，君子朝服。辅政扶德，以合万国。"},{"t":"h","l":3,"x":"毛詩序"},{"t":"p","x":"《羔羊》，鵲巢之功致也，召南之國化文王之政，在位皆節儉正直，德如羔羊也。"},{"t":"h","l":3,"x":"羔羊"},{"t":"p","x":"羔羊之皮，素絲五紽，退食自公，委蛇委蛇。"},{"t":"p","x":"羔羊之革，素絲五緎，委蛇委蛇，自公退食。"},{"t":"p","x":"羔羊之縫，素絲五緫，委蛇委蛇，退食自公。"},{"t":"p","x":"《羔羊》，三章，章四句。"}]}