{"id":1551,"workId":50,"workTitle":"杜工部集","title":"杜工部集/卷12","ord":12000000000,"ordGroup":"","chars":1948,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"奉和嚴中丞西城晚眺十韻"},{"t":"h","l":2,"x":"嚴中丞枉駕見過"},{"t":"h","l":2,"x":"廣州段功曹到得楊五長史譚書功曹卻歸聊寄此詩"},{"t":"h","l":2,"x":"得廣州張判官叔卿書，使還，以詩代意"},{"t":"p","x":"〈叔卿。魯人。見甫雜述。〉"},{"t":"h","l":2,"x":"送段功曹歸廣州"},{"t":"h","l":2,"x":"絕句漫興九首"},{"t":"h","l":2,"x":"江畔獨步尋花七絶句"},{"t":"h","l":2,"x":"三絶句"},{"t":"h","l":2,"x":"戲爲六絕句"},{"t":"h","l":2,"x":"江頭五詠"},{"t":"h","l":3,"x":"丁香"},{"t":"h","l":3,"x":"麗春"},{"t":"p","x":"百草競春華，麗春應最勝。少須好顔色，多漫枝條剩。"},{"t":"p","x":"紛紛桃李枝，處處總能移。如何貴此重，却怕有人知。"},{"t":"h","l":3,"x":"梔子"},{"t":"h","l":3,"x":"鸂鶒"},{"t":"h","l":3,"x":"花鴨"},{"t":"h","l":2,"x":"畏人"},{"t":"h","l":2,"x":"遠遊"},{"t":"h","l":2,"x":"野望"},{"t":"h","l":2,"x":"官池春雁二首"},{"t":"h","l":2,"x":"水檻遣心（一作興）二首"},{"t":"h","l":2,"x":"屛跡三首"},{"t":"h","l":2,"x":"奉酬嚴公寄題野亭之作"},{"t":"h","l":2,"x":"中丞嚴公雨中垂寄見憶一絕，奉答二絕（一作嚴公雨中見寄一絕奉答兩絕）"},{"t":"h","l":2,"x":"謝嚴中丞送青城山道士乳酒一甁"},{"t":"h","l":2,"x":"嚴公仲夏枉駕草堂，兼攜酒饌（得寒字◯草堂本一作鄭公枉駕攜饌訪水亭）"},{"t":"h","l":2,"x":"嚴公廳宴，同詠蜀道畫圖（得空字）"},{"t":"h","l":2,"x":"奉送嚴公入朝十韻"},{"t":"p","x":"酬別杜二 (嚴武)"},{"t":"h","l":2,"x":"送嚴侍郎到綿州，同登杜使君江樓（得心字）"},{"t":"h","l":2,"x":"奉濟驛重送嚴公四韻"},{"t":"h","l":2,"x":"巴西驛亭觀江漲，呈竇使君（一作竇十五使君）"},{"t":"h","l":2,"x":"九日登梓州城"},{"t":"h","l":2,"x":"巴嶺答杜二見憶 （嚴武"},{"t":"p","x":"卧向巴山落月時，兩鄉千里夢相思。可但步兵偏愛酒，也知光祿最能詩。"},{"t":"p","x":"江頭赤葉楓愁客，籬外黃花菊對誰。跋馬望君非一度，冷猿秋雁不勝悲。"},{"t":"h","l":2,"x":"九日奉寄嚴大夫"},{"t":"h","l":2,"x":"黃草"},{"t":"h","l":2,"x":"懷舊"},{"t":"h","l":2,"x":"所思（得台州鄭司戶虔消息）"},{"t":"h","l":2,"x":"不見（近無李白消息）"},{"t":"h","l":2,"x":"題玄武禪師屋壁（屋在中江大雄山）"},{"t":"h","l":2,"x":"客夜"},{"t":"h","l":2,"x":"客亭"},{"t":"h","l":2,"x":"秋盡"},{"t":"h","l":2,"x":"陪王侍御宴通泉東山野亭"},{"t":"h","l":2,"x":"野望"},{"t":"h","l":2,"x":"聞官軍收河南河北"},{"t":"h","l":2,"x":"涪江泛舟送韋班歸京（得山字）"},{"t":"h","l":2,"x":"春日梓州登樓二首"},{"t":"h","l":2,"x":"郪城西原送李判官兄、武判官弟赴成都府"},{"t":"h","l":2,"x":"泛江送魏十八倉曹還京，因寄岑中允參、范郎中季明"},{"t":"h","l":2,"x":"送路六侍御入朝"},{"t":"h","l":2,"x":"泛江送客"},{"t":