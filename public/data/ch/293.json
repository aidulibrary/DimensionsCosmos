{"id":293,"workId":5,"workTitle":"诗经","title":"詩經/訪落","ord":293,"ordGroup":"周頌閔予","chars":144,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"周頌‧閔予小子之什‧訪落"},{"t":"p","x":"毛詩序：「《訪落》，嗣王謀於廟也。」"},{"t":"h","l":3,"x":"訪落"},{"t":"p","x":"訪予落止，率時昭考。"},{"t":"p","x":"於乎悠哉！朕未有艾。將予就之，繼猶判渙。"},{"t":"p","x":"維予小子，未堪家多難。紹庭上下，陟降厥家。"},{"t":"p","x":"休矣皇考！以保明其身。"},{"t":"p","x":"《訪落》，一章，十二句。"}]}