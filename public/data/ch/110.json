{"id":110,"workId":5,"workTitle":"诗经","title":"詩經/小毖","ord":295,"ordGroup":"周頌閔予","chars":120,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"周頌‧閔予小子之什‧小毖"},{"t":"p","x":"毛詩序：「《小毖》，嗣王求助也。」"},{"t":"h","l":3,"x":"小毖"},{"t":"p","x":"予其懲，而毖後患。莫予荓蜂，自求辛螫。"},{"t":"p","x":"肇允彼桃蟲，拚飛維鳥。未堪家多難，予又集于蓼。"},{"t":"p","x":"《小毖》，一章，八句。"}]}