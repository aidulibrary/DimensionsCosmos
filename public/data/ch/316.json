{"id":316,"workId":5,"workTitle":"诗经","title":"詩經/采葛","ord":72,"ordGroup":"王","chars":118,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧王‧采葛"},{"t":"p","x":"毛詩序：「《采葛》，懼讒也。」"},{"t":"h","l":3,"x":"采葛"},{"t":"p","x":"彼采葛兮，一日不見，如三月兮。"},{"t":"p","x":"彼采蕭兮，一日不見，如三秋兮。"},{"t":"p","x":"彼采艾兮，一日不見，如三歲兮。"},{"t":"p","x":"《采葛》，三章，章三句。"}]}