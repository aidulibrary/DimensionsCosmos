{"id":172,"workId":5,"workTitle":"诗经","title":"詩經/桃夭","ord":6,"ordGroup":"周南","chars":367,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧周南‧桃夭"},{"t":"h","l":3,"x":"毛詩序"},{"t":"p","x":"《桃夭》，后妃之所致也。不妬忌，則男女以正，婚姻以時，國無鰥民也。"},{"t":"h","l":3,"x":"齊詩說"},{"t":"p","x":"按王先謙《詩三家義集疏》引陳喬樅的考證，齊詩認爲該篇詩歌實指桃花盛開。"},{"t":"h","l":3,"x":"詩文"},{"t":"p","x":"《桃夭》，三章，章四句。"}]}