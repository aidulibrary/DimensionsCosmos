{"id":307,"workId":5,"workTitle":"诗经","title":"詩經/遵大路","ord":81,"ordGroup":"鄭","chars":137,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧鄭‧遵大路"},{"t":"p","x":"毛詩序：「《遵大路》，思君子也。莊公失道，君子去之，國人思望焉。」"},{"t":"h","l":3,"x":"遵大路"},{"t":"p","x":"遵大路兮，摻執子之袪兮。無我惡兮，不寁故也。"},{"t":"p","x":"遵大路兮，摻執子之手兮。無我魗兮，不寁好也。"},{"t":"p","x":"《遵大路》，二章，章四句。"}]}