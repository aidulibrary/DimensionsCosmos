{"id":2586,"workId":9,"workTitle":"左传","title":"左传·庄公十五年","ord":44,"ordGroup":"","chars":92,"quality":"ok","qualityNote":null,"blocks":[{"t":"p","x":"【经】"},{"t":"p","x":"十有五年春，齐侯、宋公、陈侯、卫侯、郑伯会于鄄。"},{"t":"p","x":"夏，夫人姜氏如齐。"},{"t":"p","x":"秋，宋人、齐人、邾人伐郳。郑人侵宋。"},{"t":"p","x":"冬十月。"},{"t":"p","x":"【传】"},{"t":"p","x":"十五年春，复会焉，齐始霸也。"},{"t":"p","x":"秋，诸侯为宋伐郳。郑人间之而侵宋。"}]}