{"id":126,"workId":5,"workTitle":"诗经","title":"詩經/我將","ord":278,"ordGroup":"周頌清廟","chars":134,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"周頌‧清廟之什‧我將"},{"t":"p","x":"毛詩序：「《我將》，祀文王於明堂也。」"},{"t":"h","l":3,"x":"我將"},{"t":"p","x":"我將我享，維羊維牛，維天其右之。"},{"t":"p","x":"儀式刑文王之典，日靖四方。"},{"t":"p","x":"伊嘏文王，既右饗之。"},{"t":"p","x":"我其夙夜，畏天之威，于時保之。"},{"t":"p","x":"《我將》，一章，十句。"}]}