{"id":151,"workId":5,"workTitle":"诗经","title":"詩經/有客","ord":290,"ordGroup":"周頌臣工","chars":140,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"周頌‧臣工之什‧有客"},{"t":"p","x":"毛詩序：「《有客》，微子來見祖廟也。」"},{"t":"h","l":3,"x":"有客"},{"t":"p","x":"有客有客，亦白其馬。有萋有且，敦琢其旅。"},{"t":"p","x":"有客宿宿，有客信信。言授之縶，以縶其馬。"},{"t":"p","x":"薄言追之，左右綏之。既有淫威，降福孔夷。"},{"t":"p","x":"《有客》，一章，十二句。"}]}