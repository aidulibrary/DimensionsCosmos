{"id":147,"workId":5,"workTitle":"诗经","title":"詩經/時邁","ord":279,"ordGroup":"周頌清廟","chars":161,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"周頌‧清廟之什‧時邁"},{"t":"p","x":"毛詩序：「《時邁》，巡守告祭柴望也。」"},{"t":"h","l":3,"x":"時邁"},{"t":"p","x":"時邁其邦，昊天其子之。"},{"t":"p","x":"實右序有周，薄言震之，莫不震疊。"},{"t":"p","x":"懷柔百神，及河喬嶽。允王維后。"},{"t":"p","x":"明昭有周，式序在位。"},{"t":"p","x":"載戢干戈，載櫜弓矢。"},{"t":"p","x":"我求懿德，肆于時夏。"},{"t":"p","x":"允王保之。"},{"t":"p","x":"《時邁》，一章，十五句。"}]}