{"id":134,"workId":5,"workTitle":"诗经","title":"詩經/摽有梅","ord":20,"ordGroup":"召南","chars":314,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧召南‧摽有梅"},{"t":"p","x":"毛詩序：「《摽有梅》，男女及時也。召南之國，被文王之化，男女得以及時也。」"},{"t":"h","l":3,"x":"摽有梅"},{"t":"p","x":"摽有梅，其實七兮，求我庶士，迨其吉兮。"},{"t":"p","x":"摽有梅，其實三兮，求我庶士，迨其今兮。"},{"t":"p","x":"摽有梅，頃筐塈之，求我庶士，迨其謂之。"},{"t":"p","x":"《摽有梅》，三章，章四句。"}]}