{"id":71,"workId":5,"workTitle":"诗经","title":"詩經/匪風","ord":149,"ordGroup":"檜","chars":149,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧檜‧匪風"},{"t":"p","x":"毛詩序：「《匪風》，思周道也。國小政亂，憂及禍難而思周道焉。」"},{"t":"h","l":3,"x":"匪風"},{"t":"p","x":"匪風發兮，匪車偈兮。顧瞻周道，中心怛兮。"},{"t":"p","x":"匪風飄兮，匪車嘌兮。顧瞻周道，中心弔兮。"},{"t":"p","x":"誰能亨魚，溉之釜鬵。誰將西歸，懷之好音。"},{"t":"p","x":"《匪風》，三章，章四句。"}]}