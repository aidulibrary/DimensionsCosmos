{"id":13221,"workId":106,"workTitle":"二十四诗品","title":"二十四诗品/高古","ord":5,"ordGroup":"","chars":71,"quality":"ok","qualityNote":null,"blocks":[{"t":"p","x":"畸人乘真，手把芙蓉，泛彼浩劫，□然空纵。"},{"t":"p","x":"月出东，好风相从，太华夜碧，人闻清钟。"},{"t":"p","x":"虚伫神素，脱然畦封，黄唐在独，落落元宗。"},{"t":"p","x":"□〔上穴下目〕ｙａｏ３。"}],"ref":"dc:xb61a5c80/c005"}