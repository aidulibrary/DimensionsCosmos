{"id":356,"workId":5,"workTitle":"诗经","title":"詩經/麟之趾","ord":11,"ordGroup":"周南","chars":290,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧周南‧麟之趾"},{"t":"h","l":3,"x":"韓詩說"},{"t":"p","x":"美公族之盛也。"},{"t":"h","l":3,"x":"毛詩序"},{"t":"p","x":"《麟之趾》，關雎之應也。關雎之化行，則天下無犯非禮。雖衰世之公子，皆信厚如麟趾之時也。"},{"t":"h","l":3,"x":"詩文"},{"t":"p","x":"《麟之趾》，三章，章三句。"}]}