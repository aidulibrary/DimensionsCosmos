{"id":73,"workId":5,"workTitle":"诗经","title":"詩經/十畝之間","ord":111,"ordGroup":"魏","chars":149,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧魏‧十畝之間"},{"t":"p","x":"毛詩序：「《十畝之間》，刺時也。言其國削小，民無所居焉。」"},{"t":"h","l":3,"x":"十畝之間"},{"t":"p","x":"十畝之間兮，桑者閑閑兮。行與子還兮。"},{"t":"p","x":"十畝之外兮，桑者泄泄兮。行與子逝兮。"},{"t":"p","x":"《十畝之間》，二章，章三句。"}]}