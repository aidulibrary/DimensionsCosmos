{"id":193,"workId":5,"workTitle":"诗经","title":"詩經/河廣","ord":61,"ordGroup":"衞","chars":203,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧衞‧河廣"},{"t":"p","x":"毛詩序：「《河廣》，宋襄公母歸于衞，思而不止，故作是詩也。」"},{"t":"h","l":3,"x":"河廣"},{"t":"p","x":"誰謂河廣，一葦杭之，誰謂宋遠，跂予望之。"},{"t":"p","x":"誰謂河廣，曾不容刀，誰謂宋遠，曾不崇朝。"},{"t":"p","x":"《河廣》，二章，章四句。"}]}