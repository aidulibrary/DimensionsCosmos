{"id":137,"workId":5,"workTitle":"诗经","title":"詩經/敬之","ord":294,"ordGroup":"周頌閔予","chars":151,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"周頌‧閔予小子之什‧敬之"},{"t":"p","x":"毛詩序：「《敬之》，羣臣進戒嗣王也。」"},{"t":"h","l":3,"x":"敬之"},{"t":"p","x":"敬之敬之，天維顯思。"},{"t":"p","x":"命不易哉！無曰高高在上。"},{"t":"p","x":"陟降厥士，日監在茲。"},{"t":"p","x":"維予小子，不聦敬止？"},{"t":"p","x":"日就月將，學有緝熙于光明。"},{"t":"p","x":"佛時仔肩，示我顯德行。"},{"t":"p","x":"《敬之》，一章，十二句。"}]}