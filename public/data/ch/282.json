{"id":282,"workId":5,"workTitle":"诗经","title":"詩經/蘀兮","ord":85,"ordGroup":"鄭","chars":123,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧鄭‧蘀兮"},{"t":"p","x":"毛詩序：「《蘀兮》，刺忽也。君弱臣強，不倡而和也。」"},{"t":"h","l":3,"x":"蘀兮"},{"t":"p","x":"蘀兮蘀兮，風其吹女。叔兮伯兮，倡予和女。"},{"t":"p","x":"蘀兮蘀兮，風其漂女。叔兮伯兮，倡予要女。"},{"t":"p","x":"《蘀兮》，二章，章四句。"}]}