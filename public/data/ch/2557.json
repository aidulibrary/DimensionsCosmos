{"id":2557,"workId":9,"workTitle":"左传","title":"左传·桓公四年","ord":15,"ordGroup":"","chars":92,"quality":"ok","qualityNote":null,"blocks":[{"t":"p","x":"【经】"},{"t":"p","x":"四年春正月，公狩于郎。"},{"t":"p","x":"夏，天王使宰渠伯纠来聘。"},{"t":"p","x":"【传】"},{"t":"p","x":"四年春正月，公狩于郎。书时，礼也。"},{"t":"p","x":"夏，周宰渠伯纠来聘。父在，故名。"},{"t":"p","x":"秋，秦师侵芮，败焉，小之也。"},{"t":"p","x":"冬，王师、秦师围魏，执芮伯以归。"}]}