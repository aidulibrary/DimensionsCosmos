{"id":2766,"workId":9,"workTitle":"左传","title":"左传·定公十一年","ord":224,"ordGroup":"","chars":120,"quality":"ok","qualityNote":null,"blocks":[{"t":"p","x":"【经】"},{"t":"p","x":"十有一年春，宋公之弟辰及仲佗、石彄、公子地自陈入于萧以叛。"},{"t":"p","x":"夏四月。"},{"t":"p","x":"秋，宋乐大心自曹入于萧。"},{"t":"p","x":"冬，及郑平。"},{"t":"p","x":"叔还如郑涖盟。"},{"t":"p","x":"【传】"},{"t":"p","x":"十一年春，宋公母弟辰暨仲佗、石彄、公子地入于萧以叛。"},{"t":"p","x":"秋，乐大心从之，大为宋患。宠向魋故也。"},{"t":"p","x":"冬，及郑平，始叛晋也。"}]}