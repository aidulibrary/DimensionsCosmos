{"id":135,"workId":5,"workTitle":"诗经","title":"詩經/擊鼓","ord":31,"ordGroup":"邶","chars":115,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":3,"x":"齊詩說"},{"t":"p","x":"擊鼓合戰，士怯叛亡，威令不行，敗我成功。"},{"t":"h","l":3,"x":"毛詩序"},{"t":"p","x":"《擊鼓》，怨州吁也。衞州吁用兵暴亂，使公孫文仲將而平陳與宋，國人怨其勇而無禮也。"},{"t":"h","l":3,"x":"擊鼓"},{"t":"p","x":"《擊鼓》，五章，章四句。"}]}