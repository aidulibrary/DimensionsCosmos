{"id":266,"workId":5,"workTitle":"诗经","title":"詩經/芄蘭","ord":60,"ordGroup":"衞","chars":143,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧衞‧芄蘭"},{"t":"p","x":"毛詩序：「《芄蘭》，刺惠公也。驕而無禮，大夫刺之。」"},{"t":"h","l":3,"x":"芄蘭"},{"t":"p","x":"芄蘭之支，童子佩觿，雖則佩觿，能不我知，容兮遂兮，垂帶悸兮。"},{"t":"p","x":"芄蘭之葉，童子佩韘，雖則佩韘，能不我甲，容兮遂兮，垂帶悸兮。"},{"t":"p","x":"《芄蘭》，二章，章六句。"}]}