{"id":13233,"workId":106,"workTitle":"二十四诗品","title":"二十四诗品/委曲","ord":17,"ordGroup":"","chars":67,"quality":"ok","qualityNote":null,"blocks":[{"t":"p","x":"登彼太行，翠绕羊肠。杳霭深玉，悠悠花香。"},{"t":"p","x":"力之于时，声之于羌。似往已，如幽匪藏。"},{"t":"p","x":"水理漩□，鹏风翱翔。道不自器，与之圜方。"},{"t":"p","x":"□〔洑〕ｆｕ２。"}],"ref":"dc:xb61a5c80/c017"}