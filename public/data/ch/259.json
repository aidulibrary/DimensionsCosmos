{"id":259,"workId":5,"workTitle":"诗经","title":"詩經/羔裘 (唐風)","ord":120,"ordGroup":"唐","chars":131,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧唐‧羔裘"},{"t":"p","x":"毛詩序：「《羔裘》，刺時也。晉人刺其在位，不恤其民也。」"},{"t":"h","l":3,"x":"國風‧唐‧羔裘"},{"t":"p","x":"羔裘豹袪，自我人居居。豈無他人？維子之故。"},{"t":"p","x":"羔裘豹褎，自我人究究。豈無他人？維子之好。"},{"t":"p","x":"《羔裘》，二章，章四句。"}]}