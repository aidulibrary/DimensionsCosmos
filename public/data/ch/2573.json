{"id":2573,"workId":9,"workTitle":"左传","title":"左传·庄公二年","ord":31,"ordGroup":"","chars":83,"quality":"ok","qualityNote":null,"blocks":[{"t":"p","x":"【经】"},{"t":"p","x":"二年春，王二月，葬陈庄公。"},{"t":"p","x":"夏，公子庆父帅师伐於馀丘。"},{"t":"p","x":"秋七月，齐王姬卒。"},{"t":"p","x":"冬十有二月，夫人姜氏会齐侯于禚。乙酉，宋公冯卒。"},{"t":"p","x":"【传】"},{"t":"p","x":"二年冬，夫人姜氏会齐侯于禚，书奸也。"}]}