{"id":78,"workId":5,"workTitle":"诗经","title":"詩經/卷耳","ord":3,"ordGroup":"周南","chars":437,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧周南‧卷耳"},{"t":"h","l":3,"x":"魯詩說"},{"t":"p","x":"思古君子官賢人，置之列位也。"},{"t":"h","l":3,"x":"毛詩序"},{"t":"p","x":"《卷耳》，后妃之志也，又當輔佐君子，求賢審官，知臣下之勤勞，內有進賢之志，而無險詖私謁之心，朝夕思念，至於憂勤也。"},{"t":"h","l":3,"x":"詩文"},{"t":"p","x":"《卷耳》，四章，章四句。"}]}