{"id":13230,"workId":106,"workTitle":"二十四诗品","title":"二十四诗品/缜密","ord":14,"ordGroup":"","chars":70,"quality":"ok","qualityNote":null,"blocks":[{"t":"p","x":"是有真迹，如不可知，意象欲出①，造化已奇。"},{"t":"p","x":"水流花开，清露未，要路愈远，幽行为迟。"},{"t":"p","x":"语不欲犯，思不欲痴，犹春于绿，明月雪时。"},{"t":"p","x":"①他本多作“欲生”。"}],"ref":"dc:xb61a5c80/c014"}