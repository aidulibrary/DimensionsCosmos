{"id":2584,"workId":9,"workTitle":"左传","title":"左传·庄公十三年","ord":42,"ordGroup":"","chars":104,"quality":"ok","qualityNote":null,"blocks":[{"t":"p","x":"【经】"},{"t":"p","x":"十有三年春，齐侯、宋人、陈人、蔡人、邾人会于北杏。"},{"t":"p","x":"夏六月，齐人灭遂。"},{"t":"p","x":"秋七月。"},{"t":"p","x":"冬，公会齐侯，盟于柯。"},{"t":"p","x":"【传】"},{"t":"p","x":"十三年春，会于北杏以平宋乱，遂人不至。夏，齐人灭遂而戍之。"},{"t":"p","x":"冬，盟于柯，始及齐平也。"},{"t":"p","x":"宋人背北杏之会。"}]}