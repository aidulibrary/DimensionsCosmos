{"id":129,"workId":5,"workTitle":"诗经","title":"詩經/振鷺","ord":284,"ordGroup":"周頌臣工","chars":120,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"周頌‧臣工之什‧振鷺"},{"t":"p","x":"毛詩序：「《振鷺》，二王之後，來助祭也。」"},{"t":"h","l":3,"x":"振鷺"},{"t":"p","x":"振鷺于飛，于彼西雝。我客戾止，亦有斯容。"},{"t":"p","x":"在彼無惡，在此無斁。庶幾夙夜，以永終譽。"},{"t":"p","x":"《振鷺》，一章，八句。"}]}