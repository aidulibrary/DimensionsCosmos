{"id":122,"workId":5,"workTitle":"诗经","title":"詩經/式微","ord":36,"ordGroup":"邶","chars":223,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧邶‧式微"},{"t":"p","x":"毛詩序：「《式微》，黎侯寓于衞，其臣勸以歸也。」"},{"t":"h","l":3,"x":"式微"},{"t":"p","x":"式微式微，胡不歸？微君之故，胡為乎中露？"},{"t":"p","x":"式微式微，胡不歸？微君之躬，胡為乎泥中？"},{"t":"p","x":"《式微》，二章，章四句。"}]}