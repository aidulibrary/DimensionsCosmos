{"id":176,"workId":5,"workTitle":"诗经","title":"詩經/桓","ord":300,"ordGroup":"周頌閔予","chars":126,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"周頌‧閔予小子之什‧桓"},{"t":"p","x":"毛詩序：「《桓》，講武類禡也。《桓》，武志也。」"},{"t":"h","l":3,"x":"桓"},{"t":"p","x":"綏萬邦，婁豐年，天命匪解。"},{"t":"p","x":"桓桓武王，保有厥士，于以四方。克定厥家。"},{"t":"p","x":"於昭于天，皇以間之。"},{"t":"p","x":"《桓》，一章，九句。"}]}