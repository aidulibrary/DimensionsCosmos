{"id":340,"workId":5,"workTitle":"诗经","title":"詩經/風雨","ord":90,"ordGroup":"鄭","chars":147,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧鄭‧風雨"},{"t":"p","x":"毛詩序：「《風雨》，思君子也。亂世則思君子，不改其度焉。」"},{"t":"h","l":3,"x":"風雨"},{"t":"p","x":"風雨淒淒，雞鳴喈喈。既見君子，云胡不夷。"},{"t":"p","x":"風雨瀟瀟，雞鳴膠膠。既見君子，云胡不瘳。"},{"t":"p","x":"風雨如晦，雞鳴不已。既見君子，云胡不喜。"},{"t":"p","x":"《風雨》，三章，章四句。"}]}