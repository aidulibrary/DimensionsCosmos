{"id":13231,"workId":106,"workTitle":"二十四诗品","title":"二十四诗品/疏野","ord":15,"ordGroup":"","chars":70,"quality":"ok","qualityNote":null,"blocks":[{"t":"p","x":"惟性所宅，直取弗羁。控物①自富，与率为期。"},{"t":"p","x":"室松下，脱帽看诗。但知旦暮，不辨何时。"},{"t":"p","x":"倘然自适，岂必有为。若其天放，如是得之。"},{"t":"p","x":"①他本多作“拾物”。"}],"ref":"dc:xb61a5c80/c015"}