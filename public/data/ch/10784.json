{"id":10784,"workId":12,"workTitle":"说文解字","title":"说文解字/文部","ord":325,"ordGroup":"","chars":89,"quality":"ok","qualityNote":null,"blocks":[{"t":"p","x":"文：錯畫也。象交文。凡文之屬皆从文。（無分切）"},{"t":"p","x":"斐：分別文也。从文非聲。《易》曰：\"君子豹變，其文斐也。\"（敷尾切）"},{"t":"p","x":"辬：駁文也。从文辡聲。（布還切）"},{"t":"p","x":"□：微畫也。从文□聲。（里之切）"}]}