{"id":252,"workId":5,"workTitle":"诗经","title":"詩經/維天之命","ord":273,"ordGroup":"周頌清廟","chars":130,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"周頌‧清廟之什‧維天之命"},{"t":"p","x":"毛詩序：「《維天之命》，大平告文王也。」"},{"t":"h","l":3,"x":"維天之命"},{"t":"p","x":"維天之命，於穆不已。"},{"t":"p","x":"於乎不顯，文王之德之純。"},{"t":"p","x":"假以溢我，我其收之。"},{"t":"p","x":"駿惠我文王，曾孫篤之。"},{"t":"p","x":"《維天之命》，一章，八句。"}]}