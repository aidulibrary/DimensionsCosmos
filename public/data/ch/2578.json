{"id":2578,"workId":9,"workTitle":"左传","title":"左传·庄公七年","ord":36,"ordGroup":"","chars":113,"quality":"ok","qualityNote":null,"blocks":[{"t":"p","x":"【经】"},{"t":"p","x":"七年春，夫人姜氏会齐侯于防。"},{"t":"p","x":"夏四月辛卯，夜，恒星不见。夜中，星陨如雨。"},{"t":"p","x":"秋，大水。无麦、苗。"},{"t":"p","x":"冬，夫人姜氏会齐侯于穀。"},{"t":"p","x":"【传】"},{"t":"p","x":"七年春，文姜会齐侯于防，齐志也。"},{"t":"p","x":"夏，恒星不见，夜明也。星陨如雨，与雨偕也。"},{"t":"p","x":"秋，无麦、苗，不害嘉谷也。"}]}