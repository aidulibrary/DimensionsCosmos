{"id":161,"workId":5,"workTitle":"诗经","title":"詩經/東方之日","ord":99,"ordGroup":"齊","chars":149,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧齊‧東方之日"},{"t":"p","x":"毛詩序：「《東方之日》，刺衰也。君臣失道，男女淫奔，不能以禮化也。」"},{"t":"h","l":3,"x":"東方之日"},{"t":"p","x":"東方之日兮，彼姝者子，在我室兮，在我室兮，履我即兮。"},{"t":"p","x":"東方之月兮，彼姝者子，在我闥兮，在我闥兮，履我發兮。"},{"t":"p","x":"《東方之日》，二章，章五句。"}]}