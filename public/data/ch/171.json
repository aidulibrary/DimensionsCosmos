{"id":171,"workId":5,"workTitle":"诗经","title":"詩經/株林","ord":144,"ordGroup":"陳","chars":129,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧陳‧株林"},{"t":"p","x":"毛詩序：「《株林》，刺靈公也。淫乎夏姬，驅馳而往，朝夕不休息焉。」"},{"t":"h","l":3,"x":"株林"},{"t":"p","x":"胡為乎株林？從夏南。匪適株林，從夏南。"},{"t":"p","x":"駕我乘馬，說于株野。乘我乘駒，朝食于株。"},{"t":"p","x":"《株林》，二章，章四句。"}]}