{"id":337,"workId":5,"workTitle":"诗经","title":"詩經/靜女","ord":42,"ordGroup":"邶","chars":145,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧邶‧靜女"},{"t":"p","x":"毛詩序：「《靜女》，刺時也。衞君無道，夫人無德。」"},{"t":"h","l":3,"x":"靜女"},{"t":"p","x":"靜女其姝，俟我於城隅，愛而不見，搔首踟躕。"},{"t":"p","x":"靜女其孌，貽我彤管，彤管有煒，說懌女美。"},{"t":"p","x":"自牧歸荑，洵美且異，匪女之為美，美人之貽。"},{"t":"p","x":"《靜女》，三章，章四句。"}]}