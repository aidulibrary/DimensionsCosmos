{"id":277,"workId":5,"workTitle":"诗经","title":"詩經/葛覃","ord":2,"ordGroup":"周南","chars":493,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧周南‧葛覃"},{"t":"h","l":3,"x":"毛詩序"},{"t":"p","x":"《葛覃》，后妃之本也。后妃在父母家，則志在於女功之事，躬儉節用，服澣濯之衣，尊敬師傅，則可以歸安父母，化天下以婦道也。"},{"t":"h","l":3,"x":"詩文"},{"t":"p","x":"《葛覃》，三章，章六句。"}]}