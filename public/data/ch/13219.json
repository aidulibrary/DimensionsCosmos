{"id":13219,"workId":106,"workTitle":"二十四诗品","title":"二十四诗品/纤□","ord":3,"ordGroup":"","chars":82,"quality":"ok","qualityNote":null,"blocks":[{"t":"p","x":"采采流水，蓬蓬远春，窈窕幽谷①，时见美人。"},{"t":"p","x":"碧桃满树，风日水滨，柳阴路曲，流莺比邻。"},{"t":"p","x":"乘之愈往，识之愈真。如将不尽，与古为新。"},{"t":"p","x":"□〔禾农〕ｎｏｎｇ３。"},{"t":"p","x":"①他本皆作“深谷”。"}],"ref":"dc:xb61a5c80/c003"}