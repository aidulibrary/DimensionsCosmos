{"id":323,"workId":5,"workTitle":"诗经","title":"詩經/閔予小子","ord":292,"ordGroup":"周頌閔予","chars":146,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"周頌‧閔予小子之什‧閔予小子"},{"t":"p","x":"毛詩序：「《閔予小子》，嗣王朝於廟也。」"},{"t":"h","l":3,"x":"閔予小子"},{"t":"p","x":"閔予小子，遭家不造，嬛嬛在疚。"},{"t":"p","x":"於乎皇考，永世克孝，念茲皇祖，陟降庭止。"},{"t":"p","x":"維予小子，夙夜敬止。"},{"t":"p","x":"於乎皇王，繼序思不忘。"},{"t":"p","x":"《閔予小子》，一章，十一句。"}]}