{"id":262,"workId":5,"workTitle":"诗经","title":"詩經/考槃","ord":56,"ordGroup":"衞","chars":150,"quality":"ok","qualityNote":null,"blocks":[{"t":"h","l":2,"x":"國風‧衞‧考槃"},{"t":"p","x":"毛詩序：「《考槃》，刺莊公也。不能繼先公之業，使賢者退而窮處。」"},{"t":"h","l":3,"x":"考槃"},{"t":"p","x":"考槃在澗，碩人之寬，獨寐寤言，永矢弗諼。"},{"t":"p","x":"考槃在阿，碩人之薖，獨寐寤歌，永矢弗過。"},{"t":"p","x":"考槃在陸，碩人之軸，獨寐寤宿，永矢弗告。"},{"t":"p","x":"《考槃》，三章，章四句。"}]}