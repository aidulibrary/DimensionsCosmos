---
// 原文阅读页 /books/{slug}/read/
// 设计要点：
//   1) 章节目录按 chapters.ord 排序（前置附文为负值，未定位者置末）
//   2) 首章服务端直出，其余章客户端按需 fetch /data/ch/{id}.json
//   3) 章节用 hash 定位（#ch-123），可分享、可刷新还原
//   4) 质量闸门：incomplete 章顶部显式提示底本残缺
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import type { IndexData, BookMeta, Chapter, ChapterContent } from '../../../lib/data';

export async function getStaticPaths() {
  const raw = readFileSync(join(process.cwd(), 'public', 'data', 'index.json'), 'utf-8');
  const data = JSON.parse(raw) as IndexData;
  return (data.works ?? [])
    .filter((w) => w.readable)
    .map((w) => ({ params: { slug: w.slug } }));
}

const { slug } = Astro.params;
const base = Astro.site?.pathname ?? '/';

let book: BookMeta | null = null;
try {
  const idStr = (slug ?? '0').split('-')[0];
  const raw = readFileSync(join(process.cwd(), 'public', 'data', `book-${idStr}.json`), 'utf-8');
  book = JSON.parse(raw) as BookMeta;
} catch {
  book = null;
}
if (!book) {
  return new Response('未找到该书', { status: 404 });
}

const allChapters: Chapter[] = book.chapters ?? [];

// 前置附文（ord < 0）单独成组
const frontMatter = allChapters.filter((c) => typeof c.ord === 'number' && c.ord < 0);
const bodyChapters = allChapters.filter((c) => !(typeof c.ord === 'number' && c.ord < 0));

// 首章：正文第一章，没有正文则退回第一个附文
const firstChapter = bodyChapters[0] ?? allChapters[0] ?? null;

// 目录分组：ordGroup 变化处插分组标题
type TocItem = { kind: 'group'; label: string } | { kind: 'ch'; ch: Chapter };
const toc: TocItem[] = [];
let lastGroup: string | null = null;
for (const c of bodyChapters) {
  if (c.ordGroup && c.ordGroup !== lastGroup) {
    toc.push({ kind: 'group', label: c.ordGroup });
    lastGroup = c.ordGroup;
  }
  toc.push({ kind: 'ch', ch: c });
}

// 首章正文
let firstContent: ChapterContent | null = null;
if (firstChapter) {
  try {
    const raw = readFileSync(join(process.cwd(), 'public', 'data', 'ch', `${firstChapter.id}.json`), 'utf-8');
    firstContent = JSON.parse(raw) as ChapterContent;
  } catch {
    firstContent = null;
  }
}

const title = book.seed_title;
const totalChars = book.total_chars || allChapters.reduce((s, c) => s + (c.chars || 0), 0);
const incomplete = book.quality === 'incomplete';

// 校勘清单（书级）：public/data/collation.json 维护 work_id -> 待考清单页
type CollationEntry = {
  title?: string;
  label?: string;
  pending?: number;
  volumes?: number;
  url: string;
  data?: string;
  summary?: string;
};
let collation: CollationEntry | null = null;
try {
  const raw = readFileSync(join(process.cwd(), 'public', 'data', 'collation.json'), 'utf-8');
  const map = JSON.parse(raw) as { works?: Record<string, CollationEntry> };
  collation = map.works?.[String(book.id)] ?? null;
} catch {
  collation = null;
}
const collationHref = collation ? (collation.url.startsWith('http') ? collation.url : `${base}${collation.url.replace(/^\//, '')}`) : '';

// 卷级索引：vol -> 该卷待考条目数 + 首个条目锚点（用于章标题旁跳转）
type CollationItem = {
  no?: number;
  vol?: number;
  vol3?: string;
  anchor?: string;
  ctx?: string;
  cxk?: number;
  suggest?: string;
  grade?: string;
  gradeTxt?: string;
  chId?: number;
  blk?: number;
  kth?: number;
};
const collationVols: Record<string, { n: number; anchor: string }> = {};
// 校勘面板数据：随页注入，供右侧第三列直接渲染
let collationRows: Array<{
  no: number;
  vol: number;
  vol3: string;
  chId: number;
  blk: number;
  kth: number;
  ctx: string;
  cxk: number;
  sug: string;
  g: string;
  gt: string;
}> = [];
if (collation?.data) {
  try {
    const rawData = readFileSync(join(process.cwd(), 'public', collation.data), 'utf-8');
    const items = JSON.parse(rawData) as CollationItem[];
    collationRows = items
      .filter((it) => typeof it.chId === 'number' && typeof it.blk === 'number')
      .map((it) => ({
        no: Number(it.no ?? 0),
        vol: Number(it.vol ?? 0),
        vol3: String(it.vol3 ?? ''),
        chId: Number(it.chId),
        blk: Number(it.blk),
        kth: Number(it.kth ?? 0),
        ctx: String(it.ctx ?? ''),
        cxk: Number(it.cxk ?? 0),
        sug: String(it.suggest ?? ''),
        g: String(it.grade ?? ''),
        gt: String(it.gradeTxt ?? ''),
      }));
    for (const it of items) {
      if (typeof it.vol !== 'number' || !it.anchor) continue;
      const key = String(it.vol);
      if (collationVols[key]) collationVols[key].n += 1;
      else collationVols[key] = { n: 1, anchor: it.anchor };
    }
  } catch {
    /* 清单数据缺失时静默降级，仅保留书级入口 */
  }
}

// 传给客户端的最小目录（避免整份 book JSON 重复下发）
const tocLite = allChapters.map((c) => ({
  id: c.id,
  title: c.title,
  ord: c.ord,
  g: c.ordGroup,
  q: c.quality,
  n: c.qualityNote,
}));
const passData = {
  base,
  slug: slug ?? '',
  toc: tocLite,
  first: firstChapter?.id ?? null,
  collation: collation
    ? { href: collationHref, label: collation.label ?? '校勘', vols: collationVols, rows: collationRows }
    : null,
};

// 简繁/脏字标记：把正文中常见的维基残留符号做最后一次兜底清理
const cleanLine = (s: string) =>
  s
    .replace(/\[\d+\]/g, '')
    .replace(/\[(註|注|编辑|編輯|来源|來源)\]/g, '')
    .replace(/\u200b/g, '')
    .trim();

// 缺字通用呈现：把正文中的 □ 包成浅色方框，全篇可见（不止待考跳转目标）
const richLine = (s: string) =>
  cleanLine(s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/□/g, '<span class="mk-box">□</span>');

// 首章可见块序：过滤空块并保留序号，与客户端 render 的块序保持一致，供深链 #ch-<id>:b<块序>:k<序号> 定位
const firstBlocks = ((firstContent?.blocks ?? []) as any[]).filter(
  (b) => cleanLine(b?.x ?? '').length > 0,
);
---

<BaseLayout
  title={`${title} · 原文 · 维点图书馆`}
  description={`${book.author ?? '佚名'}《${title}》原文全文在线阅读，${allChapters.length} 章 ${totalChars.toLocaleString()} 字。`}
>
  <div class="reader-shell">
    <!-- 进度条 -->
    <div class="progress-wrap"><div class="progress-bar" id="progressBar"></div></div>

    <!-- 面包屑 -->
    <nav class="breadcrumb">
      <a href={base}>首页</a> / <a href={`${base}books`}>书库</a> /
      <a href={`${base}books/${slug}`}>{title}</a> / <span>原文</span>
    </nav>

    {incomplete && (
      <div class="quality-banner">
        <b>底本残缺提示</b>
        该书在线底本存在缺章或篇幅异常，部分篇章可能不完整。缺失内容不做补写，以免混淆原文。
      </div>
    )}

    <div class:list={['reader-grid', { 'has-cnav': !!collation }]}>
      <!-- 目录 -->
      <aside class="toc">
        <div class="toc-head">
          <h2>{title}</h2>
          <p class="toc-meta">
            {book.author && <span>{book.author}</span>}
            {book.dynasty && <span>· {book.dynasty}</span>}
            <span>· {allChapters.length} 章</span>
          </p>
        </div>

        {frontMatter.length > 0 && (
          <details class="toc-front">
            <summary>序跋 · 校勘 · 提要（{frontMatter.length}）</summary>
            <ul>
              {frontMatter.map((c) => (
                <li>
                  <a href={`#ch-${c.id}`} data-cid={c.id} class="toc-link front">
                    {c.title.split('/').pop()}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )}

        <ol class="toc-list">
          {toc.map((item) =>
            item.kind === 'group' ? (
              <li class="toc-group">{item.label}</li>
            ) : (
              <li>
                <a
                  href={`#ch-${item.ch.id}`}
                  data-cid={item.ch.id}
                  class:list={['toc-link', { active: item.ch.id === firstChapter?.id, bad: item.ch.quality !== 'ok' }]}
                >
                  {item.ch.title.split('/').pop()}
                </a>
              </li>
            ),
          )}
        </ol>
      </aside>

      <!-- 正文 -->
      <main class="content">
        <div class="toolbar">
          <div class="tb-left">
            <span class="tb-title" id="curTitle">{firstChapter?.title.split('/').pop() ?? ''}</span>
            <span class="tb-chars" id="curChars">
              {firstChapter ? `${firstChapter.chars.toLocaleString()} 字` : ''}
            </span>
          </div>
          <div class="tb-right">
            <button id="fontMinus" title="字号减小">A−</button>
            <button id="fontPlus" title="字号增大">A+</button>
            {collation && (
              <a class="tb-collation" href={collationHref} title={collation.summary ?? '查看校勘待考清单'}>
                {collation.label ?? '校勘'}
                {typeof collation.pending === 'number' && <em>{collation.pending}</em>}
              </a>
            )}
            <a class="tb-guide" href={`${base}read/${slug}/zhuxi`}>看解读</a>
          </div>
        </div>

        {collation && <div class="need-status" id="needStatus" hidden></div>}

        {collation && (
          <aside class="collation-bar" id="collationBar">
            <span class="cb-tag">校勘</span>
            <span class="cb-text">
              {collation.summary ?? `本作正文尚存 ${collation.pending ?? 0} 处源本残阙，三源无取证，暂保留缺字标记。`}
            </span>
            <a class="cb-link" href={collationHref}>查看待考清单 →</a>
          </aside>
        )}

        <article id="reader" class="article">
          {firstContent ? (
            <>
              <h1 class="ch-title">{firstContent.title.split('/').pop()}</h1>
              {firstContent.quality !== 'ok' && (
                <p class="ch-note">
                  ⚠ {firstContent.qualityNote || '该篇底本不完整，内容可能缺失。'}
                </p>
              )}
              {firstBlocks.map((b: any, vi: number) =>
                b.t === 'h' ? (
                  <h3 data-bi={vi} class:list={['bk-h', `lv${b.l ?? 2}`]} set:html={richLine(b.x)} />
                ) : b.t === 'q' ? (
                  <blockquote data-bi={vi} class="bk-q" set:html={richLine(b.x)} />
                ) : b.t === 'v' ? (
                  <p data-bi={vi} class="bk-v" set:html={richLine(b.x)} />
                ) : (
                  <p data-bi={vi} class="bk-p" set:html={richLine(b.x)} />
                ),
              )}
            </>
          ) : (
            <p class="empty">该章暂无正文。</p>
          )}
        </article>

        <nav class="pager">
          <button id="prevCh" class="pg-btn">← 上一篇</button>
          <a class="pg-btn back" href={`${base}books/${slug}`}>返回书籍</a>
          <button id="nextCh" class="pg-btn">下一篇 →</button>
        </nav>

        <p class="source-note">
          原文底本：中文维基文库（CC BY-SA 4.0）。已过清洗管线去除维基标记、注脚与模板残留。
        </p>
      </main>

      {collation && (
        <aside class="cnav" id="cnav" aria-label="校勘待考">
          <div class="cnav-resizer" id="cnavResizer" title="拖动调整校勘栏宽度"></div>
          <div class="cnav-head">
            <div class="cnav-tabs">
              <button type="button" class="cnav-tab active" data-scope="ch">本章</button>
              <button type="button" class="cnav-tab" data-scope="vol">本卷</button>
            </div>
            <button type="button" class="cnav-min" id="cnavMin" title="收起校勘栏">»</button>
          </div>
          <div class="cnav-meta" id="cnavMeta"></div>
          <ol class="cnav-list" id="cnavList"></ol>
          <div class="cnav-foot">
            <a href={collationHref}>完整待考清单 →</a>
          </div>
        </aside>
      )}
    </div>

    {collation && (
      <button type="button" class="cnav-open" id="cnavOpen" hidden>« 校勘待考</button>
    )}
  </div>

  <script type="application/json" id="reader-data" set:html={JSON.stringify(passData)} />
</BaseLayout>

<script>
  // 站点顶栏高度 → CSS 变量，供目录/校勘栏/工具条 sticky 计算
  const siteNav = document.querySelector('body > nav') as HTMLElement | null;
  if (siteNav) {
    const applyNavH = () => {
      document.documentElement.style.setProperty('--nav-h', Math.round(siteNav.getBoundingClientRect().height) + 'px');
    };
    applyNavH();
    window.addEventListener('resize', applyNavH, { passive: true });
  }

  const dataEl = document.getElementById('reader-data');
  const D = dataEl ? JSON.parse(dataEl.textContent || '{}') : { toc: [], base: '/' };
  const toc: { id: number; title: string; ord: number | null; g: string | null; q: string; n: string | null }[] = D.toc || [];
  const base: string = D.base || '/';
  const CH_URL = (id: number) => `${base}data/ch/${id}.json`.replace(/\/+/g, '/');

  const reader = document.getElementById('reader')!;
  const curTitle = document.getElementById('curTitle')!;
  const curChars = document.getElementById('curChars')!;
  const bar = document.getElementById('progressBar')!;
  const prevBtn = document.getElementById('prevCh') as HTMLButtonElement;
  const nextBtn = document.getElementById('nextCh') as HTMLButtonElement;

  const clean = (s: string) =>
    s.replace(/\[\d+\]/g, '').replace(/\[(註|注|编辑|編輯|来源|來源)\]/g, '').replace(/\u200b/g, '').trim();

  const idxOf = (id: number) => toc.findIndex((c) => c.id === id);

  // 缺字通用呈现：文本中每个 □ 包一层 .mk-box，便于全篇浅色可见 + 精确定位
  function paintNeed(text: string, el: HTMLElement) {
    let i = 0;
    let idx = -1;
    while ((idx = text.indexOf('□', i)) >= 0) {
      if (idx > i) el.appendChild(document.createTextNode(text.slice(i, idx)));
      const s = document.createElement('span');
      s.className = 'mk-box';
      s.textContent = '□';
      el.appendChild(s);
      i = idx + 1;
    }
    if (i < text.length) el.appendChild(document.createTextNode(text.slice(i)));
  }
  let currentIndex = D.first ? idxOf(D.first) : 0;
  if (currentIndex < 0) currentIndex = 0;

  function render(ch: any) {
    reader.innerHTML = '';
    const h1 = document.createElement('h1');
    h1.className = 'ch-title';
    h1.textContent = String(ch.title).split('/').pop() || '';
    reader.appendChild(h1);

    if (ch.quality && ch.quality !== 'ok') {
      const note = document.createElement('p');
      note.className = 'ch-note';
      note.textContent = '⚠ ' + (ch.qualityNote || '该篇底本不完整，内容可能缺失。');
      reader.appendChild(note);
    }

    let vi = 0;
    for (const b of ch.blocks || []) {
      const tag = b.t === 'h' ? 'h3' : b.t === 'q' ? 'blockquote' : 'p';
      const el = document.createElement(tag);
      el.className =
        b.t === 'h' ? `bk-h lv${b.l ?? 2}` : b.t === 'q' ? 'bk-q' : b.t === 'v' ? 'bk-v' : 'bk-p';
      const txt = clean(String(b.x || ''));
      if (!txt) continue;
      el.dataset.bi = String(vi++);
      paintNeed(txt, el);
      reader.appendChild(el);
    }
  }

  // ---- 缺字定位（深链 #ch-<章id>:b<可见块序>:k<块内第几个□>）----
  const HASH_RE = /^#ch-(\d+)(?::b(\d+):k(\d+))?$/;
  function parseHash() {
    const m = location.hash.match(HASH_RE);
    if (!m) return null;
    return {
      id: Number(m[1]),
      bi: m[2] !== undefined ? Number(m[2]) : null,
      kth: m[3] !== undefined ? Number(m[3]) : null,
    };
  }

  const needStatusEl = document.getElementById('needStatus') as HTMLElement | null;
  let needStatusTimer: number | null = null;

  function hideNeedTip() {
    if (!needStatusEl) return;
    if (needStatusTimer) {
      clearTimeout(needStatusTimer);
      needStatusTimer = null;
    }
    needStatusEl.hidden = true;
    needStatusEl.replaceChildren();
  }

  function showNeedTip(kth: number) {
    if (!needStatusEl) return;
    const C: any = (D as any).collation;
    const ord = Number(toc[currentIndex]?.ord || 0);
    const vol = ord > 1e6 ? Math.round(ord / 1e9) : 0;
    const hit = vol && C?.vols ? C.vols[String(vol)] : null;
    const msg = document.createElement('span');
    msg.textContent = hit
      ? `已定位第 ${kth + 1} 处缺字 · 本卷共 ${hit.n} 处待考`
      : `已定位第 ${kth + 1} 处缺字`;
    const frag: Node[] = [msg];
    if (C?.href) {
      const a = document.createElement('a');
      // 带上清单行锚点，回跳后该行会高亮（tr:target）
      const back = String(location.search).match(/[?&]need=([^&]+)/);
      a.href = C.href + (back ? '#' + back[1] : '');
      a.textContent = '查看待考清单 →';
      frag.push(a);
    }
    const x = document.createElement('button');
    x.type = 'button';
    x.textContent = '×';
    x.setAttribute('aria-label', '关闭提示');
    x.addEventListener('click', hideNeedTip);
    frag.push(x);
    needStatusEl.replaceChildren(...frag);
    needStatusEl.hidden = false;
    if (needStatusTimer) clearTimeout(needStatusTimer);
    needStatusTimer = window.setTimeout(hideNeedTip, 9000);
  }

  function focusNeed(bi: number, kth: number) {
    document
      .querySelectorAll('.mk-hit, .need-block')
      .forEach((e) => e.classList.remove('mk-hit', 'need-block'));
    const el = reader.querySelector(`[data-bi="${bi}"]`) as HTMLElement | null;
    if (!el) return false;
    el.classList.add('need-block');
    const boxes = el.querySelectorAll('.mk-box');
    const target = (boxes[kth] || boxes[0]) as HTMLElement | undefined;
    if (target) target.classList.add('mk-hit');
    el.scrollIntoView({ block: 'center', behavior: 'smooth' });
    return true;
  }


  // 章标题旁挂校勘徽标：仅当该书存在对应卷的待考条目
  function decorate(id: number) {
    document.querySelectorAll('.ch-collation').forEach((e) => e.remove());
    const C = (D as any).collation;
    if (!C || !C.vols) return;
    const meta = toc[idxOf(id)];
    const ord = Number(meta?.ord || 0);
    if (!ord || ord < 1e6) return;
    const hit = C.vols[String(Math.round(ord / 1e9))];
    if (!hit) return;
    const h1 = reader.querySelector('.ch-title');
    if (!h1) return;
    const a = document.createElement('a');
    a.className = 'ch-collation';
    a.href = `${C.href}#${hit.anchor}`;
    a.textContent = `${C.label || '校勘'} · 本卷 ${hit.n} 处 →`;
    a.title = '本卷正文有源本残阙，点击查看待考清单';
    h1.insertAdjacentElement('afterend', a);
  }

  // ---- 右侧第三列：校勘待考面板（同页分列，可拖拽列宽） ----
  const CNAV: any = (D as any).collation;
  const cnavEl = document.getElementById('cnav');
  const cnavListEl = document.getElementById('cnavList');
  const cnavMetaEl = document.getElementById('cnavMeta');
  const cnavGrid = document.querySelector('.reader-grid') as HTMLElement | null;
  let cnavScope: 'ch' | 'vol' = 'ch';

  const escHtml = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  // 上下文里的目标缺字强标，其余缺字弱化
  function needCtx(ctx: string, cxk: number) {
    let i = -1;
    return escHtml(ctx).replace(/□/g, () => {
      i++;
      return i === cxk ? '<em class="ci-hit">□</em>' : '<span class="ci-box">□</span>';
    });
  }

  function setCnavScope(next: 'ch' | 'vol') {
    cnavScope = next;
    document.querySelectorAll('.cnav-tab').forEach((b) => {
      b.classList.toggle('active', (b as HTMLElement).dataset.scope === next);
    });
  }

  function renderCnav() {
    if (!CNAV || !cnavListEl) return;
    const cur = toc[currentIndex];
    if (!cur) return;
    const ord = Number(cur.ord || 0);
    const vol = ord > 1e6 ? Math.round(ord / 1e9) : 0;
    const all: any[] = CNAV.rows || [];
    const inVol = all.filter((r) => r.vol === vol);
    const inCh = all.filter((r) => r.chId === cur.id);
    // 本卷条目与本章完全一致时，「本卷」页签无意义，直接隐藏
    const volTab = document.querySelector('.cnav-tab[data-scope="vol"]') as HTMLElement | null;
    const sameSet = inVol.length === inCh.length;
    if (volTab) volTab.style.display = sameSet ? 'none' : '';
    if (sameSet && cnavScope === 'vol') setCnavScope('ch');
    // 本章无条目时自动落到本卷，避免空面板
    if (cnavScope === 'ch' && !inCh.length && inVol.length) setCnavScope('vol');
    else if (cnavScope === 'vol' && !inVol.length && inCh.length) setCnavScope('ch');

    const list = cnavScope === 'ch' ? inCh : inVol;
    if (cnavMetaEl) {
      const volTxt = vol ? `卷 ${String(vol).padStart(3, '0')}` : '';
      cnavMetaEl.textContent = `${volTxt}　本章 ${inCh.length} 处 · 本卷 ${inVol.length} 处`;
    }
    cnavListEl.innerHTML = '';
    if (!list.length) {
      const li = document.createElement('li');
      li.className = 'cnav-empty';
      li.textContent = cnavScope === 'ch' ? '本篇无待考条目' : '本卷无待考条目';
      cnavListEl.appendChild(li);
      return;
    }
    for (const r of list) {
      const li = document.createElement('li');
      li.className = 'cnav-item' + (r.chId === cur.id ? ' cur' : '');
      li.dataset.ch = String(r.chId);
      li.dataset.bi = String(r.blk);
      li.dataset.kth = String(r.kth);

      const noEl = document.createElement('span');
      noEl.className = 'ci-no';
      noEl.textContent = '#' + r.no + (cnavScope === 'vol' && r.chId !== cur.id ? ' ·' + r.vol3 : '');

      const ctxEl = document.createElement('span');
      ctxEl.className = 'ci-ctx';
      ctxEl.innerHTML = needCtx(r.ctx || '', Number(r.cxk || 0));

      const tagEl = document.createElement('span');
      tagEl.className = 'ci-tag g' + (r.g || 'A');
      tagEl.textContent = r.sug ? '建议 ' + r.sug : '待考';

      li.appendChild(noEl);
      li.appendChild(ctxEl);
      li.appendChild(tagEl);
      li.title = '跳到原文该处';
      li.addEventListener('click', () => jumpNeed(r));
      cnavListEl.appendChild(li);
    }
    markCnavActive();
  }

  function markCnavActive() {
    if (!cnavListEl) return;
    const cur = toc[currentIndex];
    const H = parseHash();
    const bi = H?.bi;
    const kth = H?.kth ?? 0;
    let hit: HTMLElement | null = null;
    cnavListEl.querySelectorAll('.cnav-item').forEach((el) => {
      const e = el as HTMLElement;
      const on =
        bi !== null &&
        Number(e.dataset.ch) === cur?.id &&
        Number(e.dataset.bi) === bi &&
        Number(e.dataset.kth) === kth;
      e.classList.toggle('active', on);
      if (on) hit = e;
    });
    if (hit) hit.scrollIntoView({ block: 'nearest' });
  }

  function jumpNeed(r: any) {
    const cur = toc[currentIndex];
    if (cur && r.chId === cur.id && document.querySelector(`#reader [data-bi="${r.blk}"]`)) {
      if (focusNeed(r.blk, r.kth)) {
        history.replaceState(
          null,
          '',
          location.pathname + location.search + `#ch-${r.chId}:b${r.blk}:k${r.kth}`,
        );
        markCnavActive();
        showNeedTip(r.kth);
      }
      return;
    }
    location.hash = `#ch-${r.chId}:b${r.blk}:k${r.kth}`;
  }

  document.querySelectorAll('.cnav-tab').forEach((b) => {
    b.addEventListener('click', () => {
      setCnavScope(((b as HTMLElement).dataset.scope as 'ch' | 'vol') || 'ch');
      renderCnav();
    });
  });

  // 拖拽调宽
  const CNAV_MIN = 240;
  const CNAV_MAX = 620;
  function applyCnavWidth(w: number) {
    if (cnavGrid) cnavGrid.style.setProperty('--cnav-w', Math.round(w) + 'px');
  }
  try {
    const w0 = Number(localStorage.getItem('dc:cnav-w'));
    if (w0) applyCnavWidth(Math.min(CNAV_MAX, Math.max(CNAV_MIN, w0)));
  } catch { /* ignore */ }

  const cnavResizer = document.getElementById('cnavResizer');
  if (cnavResizer && cnavGrid) {
    cnavResizer.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      const startX = e.clientX;
      const startW = cnavEl ? cnavEl.getBoundingClientRect().width : 340;
      document.body.classList.add('cnav-resizing');
      const onMove = (ev: PointerEvent) => {
        const w = startW - (ev.clientX - startX);
        applyCnavWidth(Math.min(CNAV_MAX, Math.max(CNAV_MIN, w)));
      };
      const onUp = () => {
        document.body.classList.remove('cnav-resizing');
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('pointerup', onUp);
        try {
          localStorage.setItem(
            'dc:cnav-w',
            String(Math.round(cnavEl ? cnavEl.getBoundingClientRect().width : 340)),
          );
        } catch { /* ignore */ }
      };
      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', onUp);
    });
  }

  // 收起 / 展开
  function setCnavCollapsed(v: boolean) {
    if (!cnavGrid) return;
    cnavGrid.classList.toggle('cnav-collapsed', v);
    const openBtn = document.getElementById('cnavOpen');
    if (openBtn) openBtn.hidden = !v;
    syncCollationBar();
    try {
      localStorage.setItem('dc:cnav-collapsed', v ? '1' : '0');
    } catch { /* ignore */ }
  }
  document.getElementById('cnavMin')?.addEventListener('click', () => setCnavCollapsed(true));
  document.getElementById('cnavOpen')?.addEventListener('click', () => setCnavCollapsed(false));
  try {
    if (localStorage.getItem('dc:cnav-collapsed') === '1') setCnavCollapsed(true);
  } catch { /* ignore */ }

  // 宽屏且校勘栏展开时，正文顶部的校勘横幅与其信息重复，隐藏之
  const collationBarEl = document.getElementById('collationBar');
  function syncCollationBar() {
    if (!collationBarEl) return;
    const wide = window.matchMedia('(min-width: 1181px)').matches;
    const collapsed = !!cnavGrid?.classList.contains('cnav-collapsed');
    collationBarEl.hidden = !!(cnavEl && wide && !collapsed);
  }
  syncCollationBar();
  window.addEventListener('resize', syncCollationBar, { passive: true });

  function setActive(id: number) {
    document.querySelectorAll('.toc-link').forEach((a) => {
      a.classList.toggle('active', (a as HTMLElement).dataset.cid === String(id));
    });
    const active = document.querySelector('.toc-link.active') as HTMLElement | null;
    if (active) {
      const box = active.closest('.toc') as HTMLElement | null;
      if (box) {
        const r = active.getBoundingClientRect();
        const br = box.getBoundingClientRect();
        if (r.top < br.top + 40 || r.bottom > br.bottom - 40) {
          active.scrollIntoView({ block: 'center' });
        }
      }
    }
  }

  function updateNav() {
    prevBtn.disabled = currentIndex <= 0;
    nextBtn.disabled = currentIndex >= toc.length - 1;
    bar.style.width = toc.length ? (((currentIndex + 1) / toc.length) * 100).toFixed(2) + '%' : '0%';
  }

  const cache = new Map<number, any>();

  async function go(id: number, push = true, spot: { bi: number; kth: number } | null = null) {
    const i = idxOf(id);
    if (i < 0) return;
    currentIndex = i;
    const meta = toc[i];
    curTitle.textContent = String(meta.title).split('/').pop() || '';
    curChars.textContent = '';
    setActive(id);
    updateNav();
    if (push)
      history.replaceState(
        null,
        '',
        location.pathname + location.search + (spot ? `#ch-${id}:b${spot.bi}:k${spot.kth}` : `#ch-${id}`),
      );
    if (!spot) hideNeedTip();

    if (cache.has(id)) {
      render(cache.get(id));
    } else {
      reader.classList.add('loading');
      try {
        const res = await fetch(CH_URL(id));
        if (!res.ok) throw new Error(String(res.status));
        const json = await res.json();
        cache.set(id, json);
        render(json);
        curChars.textContent = json.chars ? json.chars.toLocaleString() + ' 字' : '';
      } catch {
        reader.innerHTML = '<p class="empty">正文加载失败，请刷新页面重试。</p>';
      } finally {
        reader.classList.remove('loading');
      }
    }
    if (!spot) window.scrollTo({ top: 0, behavior: 'smooth' });
    decorate(id);
    renderCnav();
    if (spot) {
      setTimeout(() => {
        if (focusNeed(spot.bi, spot.kth)) showNeedTip(spot.kth);
        markCnavActive();
      }, 90);
    }
    try {
      localStorage.setItem('dc:last:' + D.slug, String(id));
      localStorage.setItem('dc:toc-scroll:' + D.slug, String((document.querySelector('.toc') as HTMLElement)?.scrollTop || 0));
    } catch { /* ignore */ }
  }

  document.querySelectorAll('.toc-link').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const id = Number((a as HTMLElement).dataset.cid);
      if (id) go(id);
    });
  });

  prevBtn.addEventListener('click', () => {
    if (currentIndex > 0) go(toc[currentIndex - 1].id);
  });
  nextBtn.addEventListener('click', () => {
    if (currentIndex < toc.length - 1) go(toc[currentIndex + 1].id);
  });

  document.addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement)?.tagName === 'INPUT') return;
    if (e.key === 'ArrowLeft' && currentIndex > 0) go(toc[currentIndex - 1].id);
    if (e.key === 'ArrowRight' && currentIndex < toc.length - 1) go(toc[currentIndex + 1].id);
  });

  // 字号
  const applyFont = (px: number) => {
    document.documentElement.style.setProperty('--reader-font', px + 'px');
    try {
      localStorage.setItem('dc:font', String(px));
    } catch { /* ignore */ }
  };
  let font = 19;
  try {
    font = Number(localStorage.getItem('dc:font')) || 19;
  } catch { /* ignore */ }
  applyFont(font);
  document.getElementById('fontPlus')?.addEventListener('click', () => {
    font = Math.min(28, font + 1);
    applyFont(font);
  });
  document.getElementById('fontMinus')?.addEventListener('click', () => {
    font = Math.max(15, font - 1);
    applyFont(font);
  });

  // 初始：hash 优先（支持 #ch-<id>:b<块序>:k<序号> 深链），其次上次阅读位置
  const H0 = parseHash();
  const S0 = H0 && H0.bi !== null ? { bi: H0.bi, kth: H0.kth ?? 0 } : null;
  let target = H0?.id || 0;
  if (!target) {
    try {
      target = Number(localStorage.getItem('dc:last:' + D.slug)) || 0;
    } catch { /* ignore */ }
  }
  if (target && (target !== D.first || S0)) go(target, false, S0);
  else {
    setActive(D.first || 0);
    updateNav();
    if (D.first) decorate(D.first);
    if (S0) {
      setTimeout(() => {
        if (focusNeed(S0.bi, S0.kth)) showNeedTip(S0.kth);
        markCnavActive();
      }, 120);
    }
    renderCnav();
  }

  window.addEventListener('hashchange', () => {
    const h = parseHash();
    if (!h?.id) return;
    const spot = h.bi !== null ? { bi: h.bi, kth: h.kth ?? 0 } : null;
    if (h.id !== toc[currentIndex]?.id || spot) go(h.id, false, spot);
  });
</script>

