---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MethodSelector from '../../components/MethodSelector.astro';
import type { IndexData, BookMeta, Guide } from '../../lib/data';

export async function getStaticPaths() {
  const raw = readFileSync(join(process.cwd(), 'public', 'data', 'index.json'), 'utf-8');
  const data = JSON.parse(raw) as IndexData;
  return (data.works ?? [])
    .filter((w) => w.ok)
    .map((w) => ({
      params: { slug: w.slug },
    }));
}

const { slug } = Astro.params;
const base = Astro.site?.pathname ?? '/';

let book: BookMeta;
try {
  const idStr = (slug ?? '0').split('-')[0];
  const raw = readFileSync(join(process.cwd(), 'public', 'data', `book-${idStr}.json`), 'utf-8');
  book = JSON.parse(raw) as BookMeta;
} catch {
  return new Response('未找到该书', { status: 404 });
}

const { seed_title: title, author, dynasty, bu, chapters, guides } = book;
const guideList = guides as Guide[] ?? [];
---

<BaseLayout title={`${title} · 维点图书馆`} description={`${author}《${title}》— 可用 ${guideList.length} 种大师视角解读`}>
  <section class="book-detail">
    <!-- 面包屑 -->
    <nav class="breadcrumb">
      <a href={base}>首页</a> / <a href={`${base}books`}>书库</a> / <span>{title}</span>
    </nav>

    <!-- 书信息头 -->
    <header class="book-header">
      <h1>{title}</h1>
      <p class="meta">
        {author && <span>{author}</span>}
        {dynasty && <span>· {dynasty}</span>}
        {bu && <span class="bu-tag">{bu}</span>}
      </p>
      <p class="stats">
        <span>📄 {(chapters ?? []).length} 章</span>
        <span>🧠 {guideList.length} 种大师解读</span>
        <span>✍️ {(book.total_chars ?? 0).toLocaleString()} 字</span>
      </p>

      {book.version?.text && (
        <div class="version-box">
          <p class="version-line"><strong>版本</strong>：{book.version.text}</p>
          {book.version.structure && (
            <p class="version-sub"><strong>底本结构</strong>：{book.version.structure}</p>
          )}
          {book.version.readingTip && (
            <p class="version-sub"><strong>阅读提示</strong>：{book.version.readingTip}</p>
          )}
          {book.version.grade === 'reference' && (
            <p class="version-note">纸质版依据为出版社在版信息，尚缺国家版本备案数据，故标为参考级。</p>
          )}
        </div>
      )}

      {book.readable ? (
        <div class="read-cta">
          <a class="btn-read" href={`${base}books/${slug}/read`}>开始阅读原文 →</a>
          <span class="read-hint">可切换目录、记忆上次读到的位置</span>
        </div>
      ) : (
        <p class="read-blocked">
          该书在线底本残缺严重（{book.chapters?.[0]?.qualityNote || '篇幅异常'}），暂不提供阅读页，以免误导读者的版本判断。
        </p>
      )}
      {book.quality === 'incomplete' && book.readable && (
        <p class="read-blocked soft">⚠ 底本部分篇章不完整，阅读页会逐章标注，缺失内容不做补写。</p>
      )}
    </header>

    <!-- 已有的免费解读预览（朱熹） -->
    {guideList.filter((g) => g.method_id === 'zhuxi').map((g) => (
      <div class="preview-box">
        <h3>🆓 免费预览：朱熹读书法</h3>
        {(g.content as Record<string, unknown>)?.structure && (
          <p><strong>逻辑结构</strong>：{String((g.content as Record<string, unknown>).structure)}</p>
        )}
        {(g.content as Record<string, unknown>)?.personal_application && (
          <p><strong>切己体察</strong>：{String((g.content as Record<string, unknown>).personal_application)}</p>
        )}
        <a href={`${base}read/${slug}/zhuxi`} class="preview-link">查看完整朱熹解读 →</a>
      </div>
    ))}

    <!-- 方法选择器 -->
    <MethodSelector
      bookSlug={slug ?? ''}
      unlockedMethods={guideList.map((g) => g.method_id)}
    />
  </section>
</BaseLayout>

<style>
  section { padding: 50px 6vw 70px; max-width: 960px; margin: 0 auto; }

  .breadcrumb { font-size: 13px; color: var(--ink-soft); margin-bottom: 28px; }
  .breadcrumb a { color: var(--cinnabar); text-decoration: none; }

  .book-header {
    text-align: center; margin-bottom: 36px; padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }
  .book-header h1 { font-size: 40px; letter-spacing: 8px; margin-bottom: 12px; }
  .meta { font-size: 17px; color: var(--ink-soft); }
  .meta span { margin: 0 6px; }
  .bu-tag {
    font-size: 12px; color: var(--gold); border: 1px solid var(--gold);
    padding: 1px 8px; border-radius: 4px;
  }
  .stats { margin-top: 16px; font-size: 14px; color: var(--ink-soft); }
  .stats span { margin: 0 14px; }
  .stats a { color: var(--cinnabar); }

  .version-box {
    margin: 22px auto 0; max-width: 720px; text-align: left;
    border: 1px solid var(--line); border-radius: 8px;
    padding: 14px 18px; background: rgba(0, 0, 0, 0.02);
  }
  .version-line { font-size: 14px; line-height: 1.85; color: var(--ink); }
  .version-sub { font-size: 13px; line-height: 1.85; color: var(--ink-soft); margin-top: 6px; }
  .version-note { font-size: 12px; color: var(--ink-soft); opacity: 0.85; margin-top: 8px; }

  .read-cta { margin-top: 22px; display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .btn-read {
    display: inline-block; background: var(--cinnabar); color: var(--white);
    padding: 12px 34px; border-radius: 8px; font-size: 15px; font-weight: 700;
    letter-spacing: 2px; text-decoration: none; box-shadow: var(--shadow-sm);
    transition: background 0.18s, transform 0.18s;
  }
  .btn-read:hover { background: var(--cinnabar-deep); transform: translateY(-1px); }
  .read-hint { font-size: 12px; color: var(--ink-soft); }

  .read-blocked {
    margin: 20px auto 0; max-width: 620px; font-size: 13.5px; line-height: 1.8;
    color: #6b5a2a; background: #fdf6e3; border: 1px solid #e8d9a8;
    border-radius: 8px; padding: 12px 18px; text-align: left;
  }
  .read-blocked.soft { background: none; border: none; color: var(--ink-soft); padding: 6px 0 0; }

  .preview-box {
    background: #fff; border: 1.5px solid var(--line); border-radius: 10px;
    padding: 24px 28px; margin-bottom: 16px;
    border-left: 4px solid var(--gold);
  }
  .preview-box h3 { font-size: 17px; margin-bottom: 12px; letter-spacing: 2px; }
  .preview-box p { font-size: 15px; color: var(--ink-soft); line-height: 1.75; margin: 6px 0; }
  .preview-box p strong { color: var(--ink); }
  .preview-link {
    display: inline-block; margin-top: 10px; font-size: 14px;
    color: var(--cinnabar); font-weight: 600;
  }
</style>