---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuideView from '../../../components/GuideView.astro';
import PaywallGate from '../../../components/PaywallGate.astro';
import MethodSelector from '../../../components/MethodSelector.astro';
import ReaderPrefs from '../../../components/ReaderPrefs.astro';
import type { BookMeta, Guide } from '../../../lib/data';
import { getMethodInfo } from '../../../lib/data';

export async function getStaticPaths() {
  const ALL_METHODS = ['zhuxi', 'feynman', 'socratic', 'adler', 'qianzhongshu', 'sushi', 'wangyangming', 'arendt', 'ibn_khaldun', 'multimodal'];
  const raw = readFileSync(join(process.cwd(), 'public', 'data', 'index.json'), 'utf-8');
  const data = JSON.parse(raw) as { works: { slug: string; ok: boolean }[] };
  const paths: { params: { slug: string; method: string } }[] = [];
  for (const w of (data.works ?? [])) {
    if (!w.ok) continue;
    for (const m of ALL_METHODS) {
      paths.push({ params: { slug: w.slug, method: m } });
    }
  }
  return paths;
}

const { slug, method } = Astro.params;
const base = Astro.site?.pathname ?? '/';
/** 与 scripts/postbuild-seo.mjs 的 SITE 保持一致；Astro.site 未配置时兜底 */
const SITE = 'https://dimensionscosmos.pages.dev';

let book: BookMeta | null = null;
try {
  const idStr = (slug ?? '0').split('-')[0];
  const raw = readFileSync(join(process.cwd(), 'public', 'data', `book-${idStr}.json`), 'utf-8');
  book = JSON.parse(raw) as BookMeta;
} catch {
  book = null;
}

if (!book) {
  return new Response('未找到该书', { status: 404 });
}

const guide = (book?.guides as Guide[] ?? []).find((g) => g.method_id === method);
/** 章级 URN → 章标题，供导引用「篇名 · 第 n 块」标注引证落点 */
const chapterTitles: Record<string, string> = {};
for (const ch of ((book?.chapters ?? []) as { title?: string; ref?: string }[])) {
  if (ch?.ref && ch?.title) chapterTitles[ch.ref] = ch.title;
}
/** 章 id 序列：把原文线进度里的 id 换算成「第几篇」，与详情页续读按钮同一算法 */
const guideChapterIds = ((book?.chapters ?? []) as { id?: number }[]).map((c) => Number(c?.id) || 0);
const methodInfo = getMethodInfo(method ?? '');
const allGuides = (book?.guides as Guide[] ?? []).map((g) => g.method_id);

// 有内容就直出（当前全部免费）；无内容时按「未上架」展示，不出现任何价格或购买入口
// COMMERCE_ENABLED=false：商业化开关。关闭时绝不展示付费墙——
// 否则「这书根本没做这个视角」会被渲染成「请解锁」，既误导用户也可能引发合规问题。
const COMMERCE_ENABLED = false;
const showPaywall = COMMERCE_ENABLED && !guide && !methodInfo.free;
const paywallTitle = `${book.seed_title} x ${methodInfo.name_zh} - 维点图书馆`;
---

{showPaywall ? (
  <BaseLayout title={paywallTitle} noindex>
    <section class="paywall-page">
      <PaywallGate
        methodId={method ?? ''}
        bookSlug={slug ?? ''}
        bookTitle={book.seed_title}
        readyMethods={allGuides}
      />
    </section>
  </BaseLayout>
) : !guide ? (
  <BaseLayout title={`${book.seed_title} x ${methodInfo.name_zh} · 维点图书馆`} noindex>
    <section class="coming-soon-page">
      <nav class="breadcrumb">
        <a href={base}>首页</a> / <a href={`${base}books/${slug}`}>{book.seed_title}</a> / <span>{methodInfo.name_zh}</span>
      </nav>

      <div class="cs-card">
        <div class="cs-icon">🧠</div>
        <h2>{book.seed_title} × {methodInfo.name_zh}</h2>
        <p class="cs-meta">{book.author ?? '佚名'} · {book.dynasty ?? ''} — 以 {methodInfo.name_zh} 解读</p>
        <p class="cs-era">{methodInfo.era}</p>

        <div class="cs-divider"></div>

        <div class="cs-status">
          <span class="cs-badge">尚未上架</span>
        </div>
        <p class="cs-desc">
          《{book.seed_title}》的这一视角还在整理中，尚未生成内容，因此不提供购买入口、也不收取费用。
          在它上架前，可以先用其他视角或直接阅读原文。
        </p>

        <div class="cs-actions">
          <a href={`${base}books/${slug}`} class="btn-secondary">← 返回书详情</a>
          <a href={`${base}books/${slug}/read`} class="btn-primary">阅读原文全文</a>
        </div>

        <!-- 这本书已有的其他解读 -->
        {allGuides.length > 0 && (
          <div class="cs-existing">
            <h4>👀 这本书已有 {allGuides.length} 种解读可读</h4>
            <div class="cs-pills">
              {allGuides.map((mid) => (
                <a href={`${base}read/${slug}/${mid}`} class="cs-pill">
                  {getMethodInfo(mid).icon} {getMethodInfo(mid).name_zh}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="switch-section">
        <h3>换个已就绪的视角</h3>
        <MethodSelector
          bookSlug={slug ?? ''}
          selectedMethod={method}
          unlockedMethods={allGuides}
        />
      </div>
    </section>
  </BaseLayout>
) : (
  <BaseLayout title={`${book.seed_title} x ${methodInfo.name_zh} - 维点图书馆`}>
    {/* 结构化数据：把「某书的某视角解读」明确表达为 Book + Article + 面包屑，
        搜索引擎才能把 5400+ 章节页与 36 个导读页区分开（导读是原创评述，不是原文） */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Book',
            name: book.seed_title,
            author: { '@type': 'Person', name: book.author ?? '佚名' },
            inLanguage: 'zh-Hant',
            url: `${SITE}/books/${slug}`,
          },
          {
            '@type': 'Article',
            headline: `${book.seed_title} × ${methodInfo.name_zh}`,
            about: { '@type': 'Book', name: book.seed_title },
            inLanguage: 'zh-CN',
            ...(guide?.generated_at ? { datePublished: guide.generated_at } : {}),
            isPartOf: { '@type': 'WebSite', name: '维点图书馆', url: SITE },
            publisher: { '@type': 'Organization', name: '维点图书馆' },
          },
          {
            '@type': 'BreadcrumbList',
            itemListElement: [
              { '@type': 'ListItem', position: 1, name: '首页', item: `${SITE}/` },
              { '@type': 'ListItem', position: 2, name: book.seed_title, item: `${SITE}/books/${slug}` },
              { '@type': 'ListItem', position: 3, name: methodInfo.name_zh, item: `${SITE}/read/${slug}/${method}` },
            ],
          },
        ],
      })}
    />
    {/* 导读线进度（UX-2b）：只带 slug/method 与章 id 序列，读写全在本机 */}
    <script
      type="application/json"
      id="guide-prog-meta"
      set:html={JSON.stringify({ slug: slug ?? '', method: method ?? '', chapterIds: guideChapterIds })}
    />
    <section class="read-page">
      {/* 排版入口（UX-3b）：与原文页共用 dc:reader:v1，字号/行距/纸色跨页一致。
          只在真有导读内容时出现——「尚未上架」页没有正文可调，按钮不该在那撒谎。 */}
      <ReaderPrefs placement="floating" />
      {/* 续读提示：仅在按本机进度自动定位时出现，3.2 秒后退场 */}
      <div class="guide-resume-tip" id="guideResumeTip" role="status" aria-live="polite" hidden></div>
      <nav class="breadcrumb">
        <a href={base}>首页</a> / <a href={`${base}books/${slug}`}>{book.seed_title}</a> / <span>{methodInfo.name_zh}</span>
      </nav>

      <GuideView
        guide={guide}
        bookTitle={book.seed_title}
        bookAuthor={book.author ?? '佚名'}
        bookDynasty={book.dynasty ?? ''}
        readHref={`${base}books/${slug}/read/`}
        chapterTitles={chapterTitles}
      />

      <div class="back-to-source">
        <a class="bts-primary" id="btsLink" href={`${base}books/${slug}/read/`}>对照原文全文 →</a>
        <span class="bts-resume" id="btsResume" hidden></span>
        <span class="bts-hint">
          文中每段「本段引证」都可点开，直达原文对应章句；原文页的章标题下也会反向列出引用该篇的解读。
        </span>
      </div>

      <div class="switch-section">
        <h3>换个视角再看一遍</h3>
        <MethodSelector
          bookSlug={slug ?? ''}
          selectedMethod={method}
          unlockedMethods={allGuides}
        />
      </div>
    </section>
<script is:inline>
  // ── 导读线进度（UX-2b）────────────────────────────────────────────
  // 与原文页共用同一个键 dc:progress:<slug>，但写入独立子对象 guides[method]：
  //   键里 id/title/ratio/at 归原文线，guides 归导读线，各方法再各自一份。
  // 这样两条线来回切换都不会重置对方，也不必为同一本书维护两个键。
  (() => {
    const metaEl = document.getElementById('guide-prog-meta');
    if (!metaEl) return;
    let meta = {};
    try { meta = JSON.parse(metaEl.textContent || '{}'); } catch { return; }
    const slug = String(meta.slug || '');
    const method = String(meta.method || '');
    if (!slug || !method) return;
    const KEY = 'dc:progress:' + slug;

    const readRaw = () => {
      try {
        const p = JSON.parse(localStorage.getItem(KEY) || 'null');
        return p && typeof p === 'object' ? p : null;
      } catch { return null; }
    };
    const readMine = () => {
      const p = readRaw();
      const g = p && p.guides && typeof p.guides === 'object' ? p.guides[method] : null;
      if (!g) return null;
      return { r: Math.min(1, Math.max(0, Number(g.r) || 0)), at: Number(g.at) || 0 };
    };

    // 恢复定位的那几百毫秒内停写：scrollTo 触发的 scroll 会把比例写回 0
    let muted = false;
    const save = (r) => {
      if (muted) return;
      const prev = readMine();
      // 停在文首 3% 内不覆盖已有比例：误触一次滚动不该把阅读位置清成 0
      if (r < 0.03 && prev && prev.r > 0.05) return;
      const p = readRaw() || {};
      const guides = p.guides && typeof p.guides === 'object' ? p.guides : {};
      guides[method] = { r: Math.round(r * 1000) / 1000, at: Date.now() };
      p.guides = guides;
      try { localStorage.setItem(KEY, JSON.stringify(p)); } catch { /* 隐私模式：静默降级 */ }
    };

    // 位置用「滚动距离 / 可滚动高度」表达，与字号、行距、纸色都解耦
    const maxScroll = () => Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
    const currentRatio = () => (maxScroll() > 0 ? Math.min(1, window.scrollY / maxScroll()) : 0);

    let pending = false;
    window.addEventListener('scroll', () => {
      if (pending || muted) return;
      pending = true;
      requestAnimationFrame(() => { pending = false; save(currentRatio()); });
    }, { passive: true });

    const tipEl = document.getElementById('guideResumeTip');
    let tipTimer = 0;
    const showTip = (text) => {
      if (!tipEl) return;
      tipEl.textContent = text;
      tipEl.hidden = false;
      tipEl.classList.add('show');
      window.clearTimeout(tipTimer);
      tipTimer = window.setTimeout(() => {
        tipEl.classList.remove('show');
        window.setTimeout(() => { tipEl.hidden = true; }, 280);
      }, 3200);
    };

    // 带 hash 时是深链语义（用户点的就是某条引证），深链优先，不抢位置
    const restore = () => {
      const mine = readMine();
      if (!mine || mine.r <= 0.02 || location.hash) return;
      muted = true;
      const y = Math.round(mine.r * maxScroll());
      if (y > 0) window.scrollTo({ top: y, behavior: 'auto' });
      showTip('已回到上次读到的地方：本文 ' + Math.round(mine.r * 100) + '%');
      window.setTimeout(() => { muted = false; }, 220);
    };
    if (document.readyState === 'complete') requestAnimationFrame(restore);
    else window.addEventListener('load', () => requestAnimationFrame(restore));

    // 跨线出口：把原文线的位置带出来，导读读完不必再自己去原文里找那一段
    const link = document.getElementById('btsLink');
    const resumeEl = document.getElementById('btsResume');
    const p = readRaw();
    if (!p || !Number(p.id)) return;
    const ids = Array.isArray(meta.chapterIds) ? meta.chapterIds.map(Number) : [];
    const idx = ids.indexOf(Number(p.id));
    const pct = Math.round((Number(p.ratio) || 0) * 100);
    // 第 1 篇且篇内 <3% 不算「读到过」，别拿它冒充续读
    if (idx === 0 && pct < 3) return;
    if (link && idx >= 0) link.textContent = '接着读原文 · 第 ' + (idx + 1) + ' 篇 →';
    if (resumeEl && idx >= 0) {
      const t = String(p.title || '').split('/').pop();
      resumeEl.textContent = '上次原文读到' + (t ? '《' + t + '》' : '') + (pct > 0 ? ' · 篇内 ' + pct + '%' : '');
      resumeEl.hidden = false;
    }
  })();
</script>
  </BaseLayout>
)}


<style>
  section { padding: 50px 6vw 70px; }

  .breadcrumb { font-size: 13px; color: var(--ink-soft); margin-bottom: 28px; max-width: 760px; margin-left: auto; margin-right: auto; }
  .breadcrumb a { color: var(--cinnabar); text-decoration: none; }

  .switch-section {
    max-width: 760px; margin: 50px auto 0; padding-top: 36px;
    border-top: 1px solid var(--line);
  }
  /* 导读 → 原文：页末主入口，配合段末引证形成双向可达 */
  .back-to-source {
    max-width: 760px;
    margin: 40px auto 0;
    padding: 18px 22px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 16px;
    background: #fffdf8;
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .back-to-source .bts-primary {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--cinnabar);
    text-decoration: none;
    white-space: nowrap;
  }
  .back-to-source .bts-primary:hover { text-decoration: underline; }
  .back-to-source .bts-hint {
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--ink-soft);
    flex: 1 1 260px;
  }
  /* 跨线出口带出的原文位置：只做提示，不抢主链接的位置 */
  .back-to-source .bts-resume {
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--ink-soft);
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    white-space: nowrap;
  }
  .back-to-source .bts-resume[hidden] { display: none; }

  /* 续读提示：与原文页同款观感——只告知「回到了哪里」，不提供二次操作 */
  .guide-resume-tip {
    position: fixed;
    top: calc(var(--nav-h, 56px) + 12px);
    left: 50%;
    transform: translate(-50%, -10px);
    z-index: 70;
    max-width: min(86vw, 420px);
    padding: 9px 16px;
    border-radius: 999px;
    background: var(--accent-deep, #0a3a52);
    color: #f7f4ec;
    font-size: 13px;
    line-height: 1.5;
    letter-spacing: 0.5px;
    box-shadow: 0 10px 26px rgba(0, 32, 48, 0.26);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.24s ease, transform 0.24s ease;
  }
  .guide-resume-tip[hidden] { display: none; }
  .guide-resume-tip.show { opacity: 1; transform: translate(-50%, 0); }
  @media (prefers-reduced-motion: reduce) {
    .guide-resume-tip { transition: none; }
  }
  .switch-section h3 { font-size: 18px; letter-spacing: 2px; margin-bottom: 16px; }

  .paywall-page { padding: 0; }

  /* --- Coming-soon placeholder --- */
  .coming-soon-page { max-width: 760px; margin: 0 auto; }

  .cs-card {
    background: var(--white); border: 1.5px solid var(--line); border-radius: 14px;
    padding: 40px 32px; text-align: center; margin-bottom: 20px;
    box-shadow: var(--shadow-sm);
  }
  .cs-icon { font-size: 48px; margin-bottom: 16px; }
  .cs-card h2 { font-size: 28px; letter-spacing: 3px; margin-bottom: 8px; }
  .cs-meta { font-size: 15px; color: var(--ink-soft); margin-bottom: 4px; }
  .cs-era { font-size: 13px; color: var(--ink-soft); font-style: italic; }

  .cs-divider { width: 60px; height: 2px; background: var(--line); margin: 24px auto; }

  .cs-status { margin-bottom: 12px; }
  .cs-badge {
    display: inline-block; font-size: 14px; font-weight: 700;
    background: #fef3c7; color: #92400e; border: 1px solid #fbbf24;
    padding: 5px 16px; border-radius: 20px; letter-spacing: 1px;
  }
  .cs-desc { font-size: 14px; color: var(--ink-soft); line-height: 1.75; max-width: 520px; margin: 0 auto 24px; }

  .cs-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 28px; }
  .cs-actions a {
    display: inline-block; padding: 10px 22px; border-radius: 8px;
    font-size: 14px; font-weight: 600; text-decoration: none;
  }
  .btn-primary {
    background: var(--cinnabar); color: var(--on-accent);
  }
  .btn-primary:hover { background: var(--cinnabar-deep); }
  .btn-secondary {
    background: var(--white); color: var(--ink); border: 1.5px solid var(--line);
  }
  .btn-secondary:hover { background: var(--paper); }

  .cs-existing {
    border-top: 1px solid var(--line); padding-top: 20px; margin-top: 8px;
  }
  .cs-existing h4 { font-size: 15px; margin-bottom: 12px; color: var(--ink); }
  .cs-pills { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .cs-pill {
    display: inline-block; font-size: 13px; padding: 4px 14px;
    border-radius: 20px; text-decoration: none;
    background: var(--paper); color: var(--ink); border: 1px solid var(--line);
  }
  .cs-pill:hover { border-color: var(--cinnabar); color: var(--cinnabar); }
</style>