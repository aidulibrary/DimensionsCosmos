---
import HomeView from '../../components/HomeView.astro';
import { ACTIVE_LOCALES, DEFAULT_LOCALE, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return ACTIVE_LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<HomeView lang={locale} />
