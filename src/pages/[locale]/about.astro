---
import AboutView from '../../components/AboutView.astro';
import { ACTIVE_LOCALES, DEFAULT_LOCALE, TRANSLATED_PAGES, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return ACTIVE_LOCALES
    .filter((l) => l !== DEFAULT_LOCALE && TRANSLATED_PAGES[l].includes('/about'))
    .map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<AboutView lang={locale} />
