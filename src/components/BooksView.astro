---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import type { IndexData } from '../lib/data';
import { type Locale } from '../i18n/config';
import { href } from '../i18n/config';
import { booksDict } from '../i18n/pages/books';
import { bookDict } from '../i18n/pages/book';

interface Props {
  lang?: Locale;
}

const { lang = 'zh' } = Astro.props;
const bl = booksDict[lang];
const bd = bookDict[lang];

/* 子路径部署（GitHub Pages 预览）时 Astro.site 带 base，拼到站内链接前面 */
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
const withBase = (p: string) => `${base}${p}`;

/* 站内链接统一走 i18n 的 href()：该语言已译则带前缀，未译则回落中文页 */
const booksHref = withBase(href(lang, '/books'));

/* 构建期读取索引；缺文件时静默降级为空库，不中断整站构建 */
let indexData: IndexData | null = null;
try {
  indexData = JSON.parse(readFileSync(join(process.cwd(), 'public', 'data', 'index.json'), 'utf-8')) as IndexData;
} catch (e) {
  console.warn('[books] public/data/index.json 读取失败，按空库渲染：', e);
}

/* 静态站构建期没有 query，服务端一律输出全量书卡：SEO 与首屏最稳，
   检索与分类全部交给下方客户端脚本即时完成，不再整页刷新。 */
const books = (indexData?.works ?? []).filter((w) => w.ok);

const buSet = [...new Set((indexData?.works ?? []).map((w) => w.bu).filter(Boolean))].sort();
const buLabel = (b: string) => bd.bu[b] ?? b;

/* 客户端重算计数用的模板：把 0 换成 {n} 占位，脚本里 replace 回去 */
const countTpl = bl.countShort(0).replace('0', '{n}');
const countQTpl = bl.countQ(0, '{q}').replace('0', '{n}');
/* <title> 模板：脚本按检索词实时改写，不再整页刷新 */
const titleTpl = bl.title('{q}');
---

<BaseLayout lang={lang} title={bl.title('')}>
  <section>
    <div class="sec-head">
      <h2>{bl.heading}</h2>
      <p>{bl.sub(indexData?.ok ?? books.length)}</p>
      <div class="rule"></div>
    </div>

    <!-- 搜索：输入即过滤（客户端），无 JS 时退化为 GET 到同一页；
         store=1 由 BaseLayout 的商店保护脚本自动补隐藏域，此处不重复处理 -->
    <form class="search-bar" role="search" action={booksHref} method="get" data-books-form>
      <label class="visually-hidden" for="booksQ">{bl.searchAria}</label>
      <input
        id="booksQ"
        name="q"
        type="search"
        placeholder={bl.searchPlaceholder}
        aria-label={bl.searchAria}
        autocomplete="off"
        data-books-q
      >
      <button type="button" class="clear-btn" data-books-clear hidden>{bl.clear}</button>
      <button type="submit" class="go-btn" aria-label={bl.searchAria}>⌕</button>
    </form>

    <!-- 分类过滤：href 保留为无 JS 降级，点击时由脚本就地过滤 -->
    <div class="filters">
      <a href={booksHref} class="filter-chip active" data-bu="" aria-pressed="true">{bd.all}</a>
      {buSet.map((b) => (
        <a href={`${booksHref}?bu=${encodeURIComponent(b)}`}
           class="filter-chip" data-bu={b} aria-pressed="false">{buLabel(b)}</a>
      ))}
    </div>

    <!-- 结果 -->
    <p class="result-count" aria-live="polite">{bl.count(books.length, '', '')}</p>

    <div
      class="book-grid"
      data-count-tpl={countTpl}
      data-countq-tpl={countQTpl}
      data-title-tpl={titleTpl}
      data-empty-title={bl.emptyTitle}
    >
      {books.map((book) => <BookCard book={book} lang={lang} />)}
    </div>

    <!-- 空态：三行（发生了什么 / 下一步 / 这句留痕说明），由脚本控制显隐 -->
    <div class="empty" hidden>
      <p class="empty-title">{bl.emptyTitle}</p>
      <p class="empty-hint">{bl.emptyShort}</p>
      <p class="empty-note">{bl.emptyHint}</p>
    </div>
  </section>

  <script>
    /* 全量书卡 + 客户端即时过滤：关键词 × 部类叠加、条件写回 URL（可分享/可后退）、
       空态与「搜不到的词」留痕。所有文案来自字典，不在此硬编码任何语言。 */
    (function () {
      var form = document.querySelector('[data-books-form]') as HTMLFormElement | null;
      var input = document.querySelector('[data-books-q]') as HTMLInputElement | null;
      var clearBtn = document.querySelector('[data-books-clear]') as HTMLButtonElement | null;
      var grid = document.querySelector('.book-grid') as HTMLElement | null;
      var emptyBox = document.querySelector('.empty') as HTMLElement | null;
      var rc = document.querySelector('.result-count') as HTMLElement | null;
      if (!input || !grid || !form) return;

      var cards = Array.prototype.slice.call(grid.querySelectorAll('.book-card')) as HTMLElement[];
      var chips = Array.prototype.slice.call(document.querySelectorAll('.filter-chip')) as HTMLAnchorElement[];
      var state = { q: '', bu: '' };
      var composing = false;

      /* 归一化：全角转半角、空白合并、大小写统一，简繁与输入法差异交给数据侧 */
      function norm(s: string): string {
        return String(s || '')
          .replace(/[\uFF01-\uFF5E]/g, function (c) {
            return String.fromCharCode(c.charCodeAt(0) - 0xfee0);
          })
          .replace(/[\u3000\s]+/g, ' ')
          .toLowerCase()
          .trim();
      }

      function cardText(c: HTMLElement): string {
        return (c as any).__dcText || ((c as any).__dcText = norm(c.dataset.search || c.textContent || ''));
      }

      function readUrl() {
        var sp = new URLSearchParams(location.search);
        state.q = sp.get('q') || '';
        state.bu = sp.get('bu') || '';
        input!.value = state.q;
      }

      function writeUrl() {
        var u = new URL(location.href);
        if (state.q) u.searchParams.set('q', state.q); else u.searchParams.delete('q');
        if (state.bu) u.searchParams.set('bu', state.bu); else u.searchParams.delete('bu');
        history.replaceState(null, '', u.pathname + u.search + u.hash);
      }

      function miss(q: string) {
        try {
          var key = 'dc_search_miss';
          var list = JSON.parse(localStorage.getItem(key) || '[]');
          if (!Array.isArray(list)) list = [];
          if (list.indexOf(q) === -1) {
            list.push(q);
            localStorage.setItem(key, JSON.stringify(list.slice(-50)));
          }
        } catch (e) { /* 隐私模式忽略 */ }
      }

      function apply(pushMiss: boolean) {
        var q = norm(state.q);
        var shown = 0;
        cards.forEach(function (c) {
          var okBu = !state.bu || c.dataset.bu === state.bu;
          var okQ = !q || cardText(c).indexOf(q) > -1;
          var on = okBu && okQ;
          c.hidden = !on;
          if (on) shown += 1;
        });

        chips.forEach(function (a) {
          var on = (a.dataset.bu || '') === state.bu;
          a.classList.toggle('active', on);
          a.setAttribute('aria-pressed', on ? 'true' : 'false');
        });

        if (rc) {
          var tpl = q ? grid!.dataset.countqTpl || '' : grid!.dataset.countTpl || '';
          var buTxt = state.bu ? (chips.filter(function (a) { return a.dataset.bu === state.bu; })[0] || {} as any).textContent || '' : '';
          rc.textContent = tpl
            .replace('{n}', String(shown))
            .replace('{q}', state.q)
            .replace('{bu}', (buTxt || '').trim())
            .replace(/\s+·\s*$/, '');
        }

        if (emptyBox) emptyBox.hidden = shown !== 0;
        grid!.hidden = shown === 0;
        if (clearBtn) clearBtn.hidden = !state.q;

        var tplTitle = grid!.dataset.titleTpl || '';
        document.title = tplTitle.replace('{q}', state.q);

        if (pushMiss && q && shown === 0) miss(state.q.trim());
      }

      function commit(pushMiss: boolean) {
        apply(pushMiss);
        writeUrl();
      }

      readUrl();

      input.addEventListener('compositionstart', function () { composing = true; });
      input.addEventListener('compositionend', function () {
        composing = false;
        state.q = input.value;
        commit(true);
      });
      input.addEventListener('input', function () {
        if (composing) return;      // 中文/日文输入法拼写中不打断
        state.q = input.value;
        commit(true);
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        state.q = input.value;
        commit(true);
      });

      chips.forEach(function (a) {
        a.addEventListener('click', function (e) {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return; // 新标签页照常打开
          e.preventDefault();
          state.bu = a.dataset.bu || '';
          commit(false);
        });
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          state.q = '';
          input.value = '';
          input.focus();
          commit(false);
        });
      }

      window.addEventListener('popstate', function () {
        readUrl();
        apply(false);
      });

      apply(true);
    })();
  </script>
</BaseLayout>

<style>
  section { padding: 60px 6vw; }
  .sec-head { text-align: center; margin-bottom: 36px; }
  .sec-head h2 { font-size: 30px; letter-spacing: 6px; }
  .sec-head p { color: var(--ink-soft); margin-top: 8px; }
  .sec-head .rule { width: 56px; height: 3px; background: var(--cinnabar); margin: 16px auto 0; border-radius: 2px; }

  .visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .search-bar {
    display: flex; max-width: 520px; margin: 0 auto 24px;
    border: 1.5px solid var(--ink); border-radius: 6px; overflow: hidden; background: var(--white);
  }
  .search-bar input {
    flex: 1; min-width: 0; border: 0; outline: 0; padding: 12px 16px;
    font-size: 15px; font-family: inherit; background: transparent;
  }
  .search-bar input:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .clear-btn {
    border: 0; background: transparent; color: var(--ink-soft);
    padding: 0 12px; font-size: 12px; font-family: inherit; cursor: pointer;
    min-height: 44px;
  }
  .go-btn {
    border: 0; background: var(--accent); color: var(--on-accent);
    padding: 0 18px; font-size: 17px; cursor: pointer; min-width: 48px;
  }

  .filters { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-bottom: 20px; }
  .filter-chip {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 36px; font-size: 14px; text-decoration: none; color: var(--ink-soft);
    border: 1px solid var(--line); padding: 6px 16px; border-radius: 999px;
    background: var(--white); transition: all .2s;
  }
  .filter-chip:hover { border-color: var(--cinnabar); }
  .filter-chip.active { background: var(--brand-sky-tint); color: var(--accent-deep); border-color: var(--accent); }

  .result-count {
    text-align: center; font-size: 13px; color: var(--ink-soft); margin-bottom: 24px;
  }

  .book-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px;
  }
  .book-grid[hidden] { display: none; }

  .empty { text-align: center; padding: 56px 0; color: var(--ink-soft); }
  .empty[hidden] { display: none; }
  .empty p { margin: 8px 0; }
  .empty-title { font-size: 17px; color: var(--ink); }
  .empty-note { font-size: 12.5px; opacity: .78; }

  /* 移动端：触控目标提到 44px，避免 chip 与清除按钮点不中 */
  @media (max-width: 560px) {
    section { padding: 40px 5vw; }
    .sec-head h2 { font-size: 24px; letter-spacing: 4px; }
    .filter-chip { min-height: 44px; padding: 10px 18px; }
  }
</style>
