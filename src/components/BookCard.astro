---
import type { BookMeta } from '../lib/data';
import { type Locale, href as i18nHref } from '../i18n/config';
import { bookDict } from '../i18n/pages/book';

interface Props {
  book: BookMeta;
  minimal?: boolean;
  lang?: Locale;
}

const { book, minimal = false, lang = 'zh' } = Astro.props;
const bd = bookDict[lang];
const buLabel = book.bu ? (bd.bu[book.bu] ?? book.bu) : null;
const dynastyLabel = book.dynasty ? (bd.dynasty[book.dynasty] ?? book.dynasty) : null;
const guideCount = book.guides?.length ?? 0;
const freeGuide = book.guides?.find((g) => g.method_id === 'zhuxi');
// 详情页链接交给 i18n 的 href() 统一裁决：该语言已译则带前缀，未译则回落中文原文页
const cardHref = minimal ? '#' : i18nHref(lang, `/books/${book.slug}`);
---

<div
  class="book-card"
  data-bu={book.bu}
  data-search={[book.seed_title, book.author, book.dynasty, dynastyLabel, book.bu, buLabel].filter(Boolean).join(' ')}
>
  <a href={cardHref} class="card-link">
    <header class="card-header">
      <h3>{book.seed_title}</h3>
      {guideCount > 0 && <span class="badge">{bd.guides(guideCount)}</span>}
    </header>
    <p class="card-meta">
      {book.author && <span class="author">{book.author}</span>}
      {dynastyLabel && <span class="dynasty">{dynastyLabel}</span>}
      {buLabel && <span class="bu">{buLabel}</span>}
    </p>
    {!minimal && freeGuide && (
      <p class="preview">
        {(freeGuide.content as Record<string, unknown>)?.structure
          || (freeGuide.content as Record<string, unknown>)?.explain_to_12_year_old
          || bd.fallback}
      </p>
    )}
  </a>
  {book.readable && (
    <a class="card-read" href={i18nHref(lang, `/books/${book.slug}/read`)} aria-label={bd.readAria(book.seed_title)}>
      {bd.read} <span aria-hidden="true">→</span>
    </a>
  )}
</div>

<style>
  .book-card {
    background: var(--white);
    border: 1px solid var(--line, var(--line));
    border-radius: 8px;
    transition: transform .2s, box-shadow .2s, border-color .2s;
    overflow: hidden;
  }
  .book-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(43,41,38,.12);
    border-color: var(--cinnabar, var(--accent));
  }
  .card-link {
    display: block; padding: 20px 22px;
    text-decoration: none; color: inherit;
  }
  .card-header {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 10px;
  }
  .card-header h3 {
    font-size: 19px; letter-spacing: 2px;
    margin: 0; line-height: 1.35;
  }
  .badge {
    flex: none; font-size: 11px; font-weight: 600;
    color: var(--point);
    border: 1px solid var(--point);
    border-radius: 4px; padding: 2px 8px;
    white-space: nowrap; margin-top: 2px;
  }
  .card-meta {
    margin-top: 8px; font-size: 13px;
    color: var(--ink-soft, var(--ink-soft));
  }
  .card-meta span { margin-right: 12px; }
  .card-meta .bu {
    font-size: 11px; color: var(--gold, var(--gold));
    border: 1px solid var(--gold, var(--gold));
    border-radius: 3px; padding: 0 5px;
  }
  .preview {
    margin-top: 12px; font-size: 13px; color: var(--ink-soft, var(--ink-soft));
    line-height: 1.6; display: -webkit-box;
    -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
    border-top: 1px dotted var(--line, var(--line));
    padding-top: 10px;
  }
  .card-read {
    display: block; padding: 10px 22px;
    border-top: 1px solid var(--line, var(--line));
    font-size: 13px; letter-spacing: 1px;
    color: var(--cinnabar, var(--accent)); text-decoration: none;
    background: rgba(158,43,37,.03);
    transition: background .2s, letter-spacing .2s;
  }
  .card-read:hover { background: rgba(158,43,37,.08); letter-spacing: 2px; }

  /* 窄屏密度：内边距收紧、标题降一档、预览保留两行免得卡片过高 */
  @media (max-width: 480px) {
    .card-link { padding: 16px 18px; }
    .card-header h3 { font-size: 17px; letter-spacing: 1px; }
    .card-meta { margin-top: 6px; font-size: 12.5px; }
    .card-meta span { margin-right: 10px; }
    .preview { margin-top: 10px; font-size: 12.5px; padding-top: 8px; }
    .card-read { padding: 12px 18px; }
  }
</style>