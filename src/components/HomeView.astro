---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from './BookCard.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import type { IndexData } from '../lib/data';
import { getAllMethods } from '../lib/data';
import { type Locale, href } from '../i18n/config';
import { ui } from '../i18n/ui';
import { home } from '../i18n/pages/home';
import { bookDict } from '../i18n/pages/book';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = home[lang];
const u = ui[lang];

let indexData: IndexData | null = null;
try {
  indexData = JSON.parse(readFileSync(join(process.cwd(), 'public', 'data', 'index.json'), 'utf-8')) as IndexData;
} catch {
  indexData = null;
}

const works = indexData?.works?.filter((w) => w.ok) ?? [];
const byBu = indexData?.byBu ?? {};
const methods = getAllMethods();
const freeMethods = methods.filter((m) => m.free);
const total = indexData?.ok ?? 0;
---

<BaseLayout lang={lang} title={t.title} description={t.description}>
  <section class="hero">
    <div>
      <span class="hero-kicker">{t.kicker}</span>
      <h1 set:html={t.h1Html} />
      <p class="motto">{t.motto}</p>
      <p class="sub">{t.sub}</p>
      <div class="hero-search">
        <input id="q" type="text" placeholder={t.searchPlaceholder} autocomplete="off">
        <button onclick={`const q=document.getElementById('q').value;if(q)location.href='${href(lang, '/books')}?q='+encodeURIComponent(q)`}>{t.searchBtn}</button>
      </div>
      <div class="hero-stats">
        <a href={href(lang, '/books')} class="stat-link"><b>{total}</b><span>{t.statBooks}</span></a>
        <a href={href(lang, '/methods')} class="stat-link"><b>{methods.length}</b><span>{t.statMethods}</span></a>
        <a href={href(lang, '/pricing')} class="stat-link"><b>{freeMethods.length}</b><span>{t.statFree}</span></a>
      </div>
    </div>
    <div class="hero-art">
      <div class="hero-placeholder">
        <span class="hero-big-icon">📚</span>
        {t.heroArt.map((line) => <p>{line}</p>)}
      </div>
      <span class="vertical-note">{t.verticalNote}</span>
    </div>
  </section>

  <section class="library">
    <div class="sec-head">
      <h2>{t.libTitle}</h2>
      <p>{t.libSub.replace('{n}', String(total))}</p>
      <div class="rule"></div>
    </div>
    <div class="filters" id="filters">
      <button class="active" data-bu="">{u.common.all}</button>
      {Object.keys(byBu).sort().map((bu) => (
        <button data-bu={bu}>{bookDict[lang].bu[bu] ?? bu}</button>
      ))}
    </div>
    <div class="book-grid">
      {works.slice(0, 50).map((book) => (
        <BookCard book={book} lang={lang} />
      ))}
    </div>
    <p class="center-link">
      <a href={href(lang, '/books')}>{t.browseAll}</a>
    </p>
  </section>

  <section class="method-strip">
    <div class="strip-inner">
      <div class="strip-text">
        <h3>{t.stripTitle}</h3>
        <p>{t.stripSub.replace('{n}', String(methods.length))}</p>
      </div>
      <div class="strip-pills">
        {methods.slice(0, 5).map((m) => (
          <a href={`${href(lang, '/methods')}#${m.id}`} class="strip-pill">
            {m.icon} {lang === 'zh' || lang === 'zh-TW' ? m.name_zh : m.name_en}
          </a>
        ))}
        <a href={href(lang, '/methods')} class="strip-pill more">{t.stripMore.replace('{n}', String(methods.length - 5))}</a>
      </div>
    </div>
  </section>

  <section class="open-band">
    {t.band.map((item) => (
      <div>
        <h4>{item.title}</h4>
        <p>{item.desc}</p>
      </div>
    ))}
  </section>
</BaseLayout>

<script>
  document.querySelectorAll('#filters button').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#filters button').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const bu = btn.dataset.bu;
      document.querySelectorAll('.book-card').forEach((card) => {
        card.style.display = !bu || card.dataset.bu === bu ? '' : 'none';
      });
    });
  });
</script>

<style>
  .hero {
    display: grid; grid-template-columns: 1.1fr .9fr; gap: 5vw;
    align-items: center; padding: 72px 6vw 56px;
  }
  .hero-kicker {
    display: inline-block; font-size: 13px; letter-spacing: 3px;
    color: var(--cinnabar); border: 1px solid var(--cinnabar);
    padding: 3px 12px; border-radius: 999px; margin-bottom: 22px;
  }
  .hero h1 { font-size: clamp(34px, 4.6vw, 58px); line-height: 1.3; letter-spacing: 2px; }
  .hero h1 em { font-style: normal; color: var(--cinnabar); }
  .hero p.motto { margin-top: 16px; font-size: 18px; letter-spacing: 6px; color: var(--cinnabar); }
  .hero p.sub { margin: 14px 0 30px; color: var(--ink-soft); font-size: 17px; max-width: 34em; line-height: 1.7; }
  .hero-search { display: flex; max-width: 520px; border: 1.5px solid var(--ink); border-radius: 6px; overflow: hidden; background: var(--white); }
  .hero-search input { flex: 1; border: 0; outline: 0; padding: 14px 16px; font-size: 16px; font-family: inherit; background: transparent; }
  .hero-search button { border: 0; background: var(--cinnabar); color: var(--on-accent); padding: 0 26px; font-size: 16px; font-family: inherit; cursor: pointer; }
  .hero-search button:hover { background: var(--cinnabar-deep); }
  .hero-stats { display: flex; gap: 36px; margin-top: 34px; }
  .stat-link { text-decoration: none; color: inherit; transition: transform .2s; }
  .stat-link:hover { transform: translateY(-2px); }
  .stat-link:hover b { color: var(--cinnabar-deep); }
  .hero-stats b { font-size: 26px; color: var(--cinnabar); display: block; transition: color .2s; }
  .hero-stats span { display: block; font-size: 13px; color: var(--ink-soft); }
  .hero-art { position: relative; }
  .hero-placeholder {
    background: var(--paper-deep); border: 1px solid var(--line);
    border-radius: 12px; padding: 40px 30px; text-align: center;
    box-shadow: 0 18px 50px rgba(43,41,38,.12);
  }
  .hero-big-icon { font-size: 56px; display: block; margin-bottom: 16px; }
  .hero-placeholder p { font-size: 14px; color: var(--ink-soft); line-height: 2; letter-spacing: 2px; }
  .hero-art .vertical-note {
    position: absolute; right: -14px; top: 24px;
    writing-mode: vertical-rl; letter-spacing: 6px;
    background: var(--paper); border: 1px solid var(--line);
    padding: 14px 8px; border-radius: 4px; font-size: 14px; color: var(--ink-soft);
    box-shadow: 0 6px 18px rgba(43,41,38,.1);
  }

  section { padding: 64px 6vw; }
  .sec-head { text-align: center; margin-bottom: 44px; }
  .sec-head h2 { font-size: 30px; letter-spacing: 6px; }
  .sec-head p { color: var(--ink-soft); margin-top: 8px; }
  .sec-head .rule { width: 56px; height: 3px; background: var(--cinnabar); margin: 16px auto 0; border-radius: 2px; }

  .library { background: var(--paper-deep); }
  .filters { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 30px; }
  .filters button {
    font-family: inherit; font-size: 15px; cursor: pointer;
    border: 1px solid var(--line); background: var(--white); color: var(--ink-soft);
    padding: 7px 20px; border-radius: 999px;
  }
  .filters button.active { background: var(--brand-sky-tint); color: var(--accent-deep); border-color: var(--accent); }
  .book-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px;
  }
  .center-link { text-align: center; margin-top: 28px; }
  .center-link a { color: var(--cinnabar); font-size: 15px; text-decoration: none; }
  .center-link a:hover { text-decoration: underline; }

  /* 方法引导条 */
  .method-strip {
    background: var(--white); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .strip-inner {
    max-width: 960px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: center;
  }
  .strip-text h3 { font-size: 18px; letter-spacing: 2px; margin-bottom: 4px; }
  .strip-text p { font-size: 14px; color: var(--ink-soft); }
  .strip-pills { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
  .strip-pill {
    font-size: 13px; text-decoration: none; color: var(--ink);
    background: var(--paper-deep); border: 1px solid var(--line);
    padding: 7px 14px; border-radius: 999px; transition: all .2s;
  }
  .strip-pill:hover { border-color: var(--cinnabar); }
  .strip-pill.more { color: var(--cinnabar); font-weight: 600; }

  .open-band {
    /* 结构面①：星穹蓝承载「开放数据」区，纸墨之外的唯一大色块 */
    background: var(--surface-brand); color: var(--brand-on-sky);
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 26px;
  }
  .open-band h4 { color: var(--brand-on-sky); font-size: 16px; margin-bottom: 8px; letter-spacing: 2px; }
  .open-band p { font-size: 13.5px; color: var(--brand-on-sky-soft); line-height: 1.75; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero-art .vertical-note { display: none; }
    .open-band { grid-template-columns: repeat(2, 1fr); }
    .strip-inner { grid-template-columns: 1fr; }
    .strip-pills { justify-content: flex-start; }
  }
</style>
