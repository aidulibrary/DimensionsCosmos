---
/**
 * 「定价」视图：pricing.astro 与 [locale]/pricing.astro 共用。
 *
 * 商店模式（html.store-mode）下的行为保持不变：
 * 凡带 data-store-hide 的付费语境整块隐藏，.store-only 的免费措辞显示，
 * 确保商店版用户看不到任何站外付费入口。
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllMethods, getMethodInfo } from '../lib/data';
import { PAY_ENABLED, OPERATOR } from '../config/commerce';
import { type Locale, href } from '../i18n/config';
import { pricingDict } from '../i18n/pages/pricing';

interface Props {
  lang?: Locale;
}

const { lang = 'zh' } = Astro.props;
const t = pricingDict[lang];

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
const withBase = (p: string) => `${base}${p}`;
const link = (p: string) => withBase(href(lang, p));

type GuideRef = { method_id: string };
type WorkRef = {
  id: number;
  slug: string;
  seed_title: string;
  author?: string;
  dynasty?: string;
  ok: boolean;
  chapter_count: number;
  total_chars: number;
  guides: GuideRef[];
};

const idx = JSON.parse(
  readFileSync(join(process.cwd(), 'public', 'data', 'index.json'), 'utf-8'),
) as { total: number; ok: number; readable: number; works: WorkRef[] };

const works = (idx.works ?? []).filter((w) => w.ok);
const totalChapters = works.reduce((s, w) => s + (w.chapter_count || 0), 0);
const totalChars = works.reduce((s, w) => s + (w.total_chars || 0), 0);

// 已上架商品 = 数据里真实存在的导读，且方法为付费方法
const paidMethods = getAllMethods().filter((m) => !m.free);
const paidMethodIds = new Set(paidMethods.map((m) => m.id));
const shelf = works
  .flatMap((w) =>
    (w.guides ?? [])
      .filter((g) => paidMethodIds.has(g.method_id))
      .map((g) => ({ work: w, methodId: g.method_id, method: getMethodInfo(g.method_id) })),
  )
  .filter((x) => x.method && x.methodId);

const shelfCount = shelf.length;
const coveredWorks = new Set(shelf.map((s) => s.work.id)).size;
const pendingWorks = works.length - coveredWorks;

/* 说明列的数据源（method.summary）目前只有中文，非中日文语言下不展示，避免英文页整句中文 */
const showDesc = lang === 'zh' || lang === 'zh-TW';

const priceRange = paidMethods.length
  ? `¥${Math.min(...paidMethods.map((m) => m.price))}–${Math.max(...paidMethods.map((m) => m.price))}`
  : '¥3.9';
---

<BaseLayout title={t.pageTitle} lang={lang}>
  <section>
    <div class="sec-head">
      <h2>{t.h2}</h2>
      <p data-store-hide>{t.taglineWeb}</p>
      <p class="store-only">{t.taglineStore}</p>
      <div class="rule"></div>
    </div>

    <!-- 真实供给概览：与数据现状一致，不承诺未建成的内容 -->
    <div class="supply-bar">
      <div class="sb-item"><b>{works.length}</b><span>{t.supplyBooks}</span></div>
      <div class="sb-item"><b>{totalChapters.toLocaleString()}</b><span>{t.supplyChapters}</span></div>
      <div class="sb-item"><b>{Math.round(totalChars / 10000).toLocaleString()}</b><span>{t.supplyChars}</span></div>
      <div class="sb-item"><b>{shelfCount}</b><span>{t.supplyShelf}</span></div>
    </div>

    <div class="pricing-grid">
      <div class="price-card">
        <div class="card-badge free-badge">{t.freeBadge}</div>
        <h3>{t.freeTitle}</h3>
        <div class="amount">¥0</div>
        <p class="card-desc">{t.freeDesc(works.length.toLocaleString(), totalChapters.toLocaleString())}</p>
        <ul>
          {t.freeItems.map((item) => <li>{item}</li>)}
        </ul>
        <a href={link('/books')} class="card-btn ghost">{t.freeCta}</a>
      </div>

      <div class="price-card featured">
        <div class="card-badge hot-badge">{PAY_ENABLED ? t.guideBadgeOn : t.guideBadgeOff}</div>
        <h3>{t.guideTitle}</h3>
        <div class="amount">
          {PAY_ENABLED ? priceRange.split('–')[0] : '¥0'}
          <span>{PAY_ENABLED ? t.guidePerUnit : t.guideLimited}</span>
        </div>
        <p class="card-desc">{PAY_ENABLED ? t.guideDescOn(shelfCount) : t.guideDescOff(shelfCount)}</p>
        <ul>
          {(PAY_ENABLED ? t.guideItemsOn : t.guideItemsOff).map((item, i) => (
            <li {...(i === 2 && PAY_ENABLED ? { 'data-store-hide': '' } : {})}>{item}</li>
          ))}
        </ul>
        {PAY_ENABLED
          ? shelf.length > 0 && (
              <a href={`${base}read/${shelf[0].work.slug}/${shelf[0].method.id}`} class="card-btn solid">
                {t.guideCtaOn}
              </a>
            )
          : <a href="#shelf" class="card-btn solid">{t.guideCtaOff}</a>}
      </div>

      <div class="price-card" data-store-hide>
        <div class="card-badge">{t.packBadge}</div>
        <h3>{t.packTitle}</h3>
        <div class="amount">¥49<span>{t.packPerUnit}</span></div>
        <p class="card-desc">{t.packDesc}</p>
        <ul>
          {t.packItems(getAllMethods().length).map((item) => <li>{item}</li>)}
        </ul>
        <a href="#" class="card-btn ghost disabled">{t.packCta}</a>
      </div>
    </div>

    <!-- 已上架清单：只列真实存在、点开即能读的内容 -->
    <div class="shelf" id="shelf">
      <h3>{t.shelfTitle(shelfCount, coveredWorks)}</h3>
      {shelfCount === 0 ? (
        <p class="shelf-empty">{t.shelfEmpty}</p>
      ) : (
        <ul class="shelf-list">
          {shelf.map(({ work, methodId, method }) => (
            <li>
              <a href={`${base}read/${work.slug}/${methodId}`} class="shelf-item">
                <span class="si-book">《{work.seed_title}》</span>
                <span class="si-method">{method.icon} {method.name_zh}</span>
                <span class="si-price">{PAY_ENABLED ? `¥${method.price}` : t.shelfFree}</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      {pendingWorks > 0 && (
        <p class="shelf-note">
          {t.shelfNotePrefix}{pendingWorks}<b>{t.shelfNoteBold}</b>{t.shelfNoteSuffix}
        </p>
      )}
    </div>

    <!-- 付费方法单价表 -->
    <div class="price-table-wrap" data-store-hide>
      <h3>{t.tableTitle}</h3>
      <table class="price-table">
        <thead>
          <tr><th>{t.thMethod}</th><th>{t.thEra}</th><th>{t.thPrice}</th>{showDesc && <th>{t.thDesc}</th>}</tr>
        </thead>
        <tbody>
          {paidMethods.map((m) => (
            <tr>
              <td><strong>{m.icon} {m.name_zh}</strong></td>
              <td class="era-cell">{m.era.split('·')[0]}</td>
              <td class="price-cell">¥{m.price}</td>
              {showDesc && <td class="desc-cell">{m.summary}</td>}
            </tr>
          ))}
        </tbody>
      </table>
      <p class="table-note">{t.tableNote}</p>
    </div>

    <!-- 信任区 -->
    <div class="trust">
      <div data-store-hide>
        <h4>{t.payTitle}</h4>
        <p>{PAY_ENABLED ? t.payOn : t.payOff}</p>
      </div>
      <div>
        <h4>{t.refundTitle}</h4>
        <p>{t.refundPrefix}<a href={link('/refund')}>{t.refundLink}</a>{t.refundSuffix}</p>
      </div>
      <div>
        <h4>{t.contactTitle}</h4>
        <p>
          {t.contactPrefix}<a href={link('/terms')}>{t.contactTerms}</a>{t.contactMid}<a href={link('/about')}>{t.contactAbout}</a>{t.contactSuffix}<a href={OPERATOR.repo}>{OPERATOR.repo.replace('https://', '')}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  section { padding: 60px 6vw; max-width: 1060px; margin: 0 auto; }
  .sec-head { text-align: center; margin-bottom: 40px; }
  .sec-head h2 { font-size: 30px; letter-spacing: 6px; }
  .sec-head p { color: var(--ink-soft); margin-top: 8px; }
  /* 商店模式下才出现的免费措辞（网页模式不渲染） */
  .store-only { display: none; }
  html.store-mode .store-only { display: block; }

  .sec-head .rule { width: 56px; height: 3px; background: var(--cinnabar); margin: 16px auto 0; border-radius: 2px; }

  .supply-bar {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;
    margin-bottom: 40px;
  }
  .sb-item {
    background: var(--white); border: 1px solid var(--line); border-radius: 10px;
    padding: 16px 10px; text-align: center;
  }
  .sb-item b { display: block; font-size: 24px; color: var(--cinnabar); letter-spacing: 1px; }
  .sb-item span { font-size: 12.5px; color: var(--ink-soft); }

  .pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-bottom: 46px; }

  .price-card {
    background: var(--white); border: 1px solid var(--line); border-radius: 12px;
    padding: 34px 28px; text-align: center; position: relative;
    display: flex; flex-direction: column;
  }
  .price-card.featured { border: 2px solid var(--cinnabar); box-shadow: 0 8px 30px rgba(158,43,37,.1); }
  .card-badge {
    display: inline-block; font-size: 12px; letter-spacing: 2px;
    padding: 3px 14px; border-radius: 999px; margin-bottom: 14px;
    border: 1px solid var(--line);
  }
  .free-badge { color: #2d8a56; border-color: #2d8a56; }
  .hot-badge {
    background: var(--cinnabar); color: var(--on-accent); border-color: var(--cinnabar);
    position: absolute; top: -13px; left: 50%; transform: translateX(-50%);
  }
  .price-card h3 { font-size: 19px; letter-spacing: 3px; }
  .amount { font-size: 40px; color: var(--cinnabar); margin: 12px 0 4px; font-weight: 700; }
  .amount span { font-size: 14px; color: var(--ink-soft); font-weight: 400; }
  .card-desc { font-size: 14px; color: var(--ink-soft); margin-bottom: 18px; }
  .price-card ul { list-style: none; margin-bottom: 24px; flex: 1; padding: 0; }
  .price-card li { padding: 6px 0; font-size: 14px; color: var(--ink-soft); }
  .price-card li::before { content: "✓ "; color: var(--gold); font-weight: 700; }

  .card-btn {
    display: block; padding: 13px 0; font-size: 15px; font-weight: 700;
    text-decoration: none; border-radius: 8px; letter-spacing: 1px;
  }
  .card-btn.solid { background: var(--cinnabar); color: var(--on-accent); }
  .card-btn.solid:hover { background: var(--cinnabar-deep); }
  .card-btn.ghost { border: 1.5px solid var(--ink); color: var(--ink); }
  .card-btn.ghost:hover { background: var(--ink); color: var(--paper); }
  .card-btn.disabled { opacity: .4; pointer-events: none; }

  /* 已上架清单 */
  .shelf { margin-bottom: 46px; }
  .shelf h3 { font-size: 18px; letter-spacing: 3px; margin-bottom: 16px; }
  .shelf-list {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px;
  }
  .shelf-item {
    display: flex; align-items: center; gap: 10px;
    background: var(--white); border: 1px solid var(--line); border-radius: 9px;
    padding: 12px 14px; text-decoration: none; color: var(--ink);
  }
  .shelf-item:hover { border-color: var(--cinnabar); }
  .si-book { font-weight: 700; letter-spacing: 1px; }
  .si-method { font-size: 13px; color: var(--ink-soft); flex: 1; }
  .si-price { font-size: 12.5px; color: var(--cinnabar); font-weight: 700; }
  .shelf-empty, .shelf-note {
    font-size: 13px; color: var(--ink-soft); line-height: 1.8;
    background: var(--paper-deep); border-radius: 8px; padding: 14px 16px; margin-top: 14px;
  }

  /* 单价表 */
  .price-table-wrap { margin-bottom: 46px; }
  .price-table-wrap h3 { font-size: 18px; letter-spacing: 3px; margin-bottom: 18px; }
  .price-table {
    width: 100%; border-collapse: collapse; background: var(--white);
    border-radius: 8px; overflow: hidden; border: 1px solid var(--line);
  }
  .price-table th {
    text-align: left; padding: 14px 18px; background: var(--brand-sky-tint);
    font-size: 13px; letter-spacing: 2px; color: var(--accent-deep); font-weight: 600;
  }
  .price-table td { padding: 14px 18px; font-size: 14px; border-top: 1px solid var(--line); }
  .price-cell { color: var(--cinnabar); font-weight: 700; }
  .desc-cell { color: var(--ink-soft); font-size: 13px !important; }
  .era-cell { color: var(--ink-soft); font-size: 13px; }
  .table-note { margin-top: 12px; font-size: 12.5px; color: var(--ink-soft); }

  .trust {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px;
    padding-top: 36px; border-top: 1px solid var(--line);
  }
  .trust h4 { font-size: 15px; letter-spacing: 2px; margin-bottom: 8px; }
  .trust p { font-size: 13.5px; color: var(--ink-soft); line-height: 1.7; }
  .trust a { color: var(--cinnabar); }

  @media (max-width: 800px) {
    .pricing-grid, .trust, .supply-bar, .shelf-list { grid-template-columns: 1fr; }
  }
</style>
