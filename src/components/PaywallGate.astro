---
// 「未上架」说明卡：用于该书 × 该方法尚未生成导读的情况。
// 设计约束：没有内容就不出现任何购买按钮、不出现价格，避免对未交付内容收费。
import { getMethodInfo } from '../lib/data';

export interface Props {
  methodId: string;
  bookSlug: string;
  bookTitle?: string;
  readyMethods?: string[];
}

const { methodId, bookSlug, bookTitle, readyMethods = [] } = Astro.props;
const methodInfo = getMethodInfo(methodId);
const base = Astro.site?.pathname ?? '/';
---

<div class="pending-wrap">
  <div class="pending-card">
    <div class="pending-badge">尚未生成 · 未上架</div>
    <h2>{methodInfo.icon} {methodInfo.name_zh}</h2>
    <p class="pending-era">{methodInfo.era}</p>
    <p class="pending-desc">
      《{bookTitle ?? '本书'}》的这一视角还没有生成，因此这里<b>不提供购买入口</b>。
      生成完成后会自动出现在定价页的「已上架导读」清单里。
    </p>

    <div class="pending-actions">
      <a href={`${base}books/${bookSlug}`} class="btn-secondary">← 返回书详情</a>
      <a href={`${base}books/${bookSlug}/read`} class="btn-primary">阅读原文全文</a>
    </div>

    {readyMethods.length > 0 && (
      <div class="pending-ready">
        <h4>这本书已有 {readyMethods.length} 种视角可读</h4>
        <div class="pending-pills">
          {readyMethods.map((mid) => {
            const m = getMethodInfo(mid);
            return (
              <a href={`${base}read/${bookSlug}/${mid}`} class="pending-pill">
                {m.icon} {m.name_zh}
              </a>
            );
          })}
        </div>
      </div>
    )}

    <p class="pending-foot">
      内容进度与收录范围见 <a href={`${base}pricing`}>定价页</a>
    </p>
  </div>
</div>

<style>
  .pending-wrap { padding: 70px 6vw 90px; display: grid; place-items: center; }
  .pending-card {
    background: #fff; border: 1.5px solid var(--line); border-radius: 16px;
    padding: 42px 34px; max-width: 540px; width: 100%; text-align: center;
    box-shadow: 0 10px 34px rgba(43, 41, 38, .07);
  }
  .pending-badge {
    display: inline-block; font-size: 12.5px; letter-spacing: 3px;
    border: 1.5px solid var(--gold); color: #8a6d1f; background: #fdf8e8;
    padding: 4px 16px; border-radius: 999px; margin-bottom: 18px;
  }
  .pending-card h2 { font-size: 24px; letter-spacing: 3px; margin-bottom: 6px; }
  .pending-era { font-size: 13px; color: var(--ink-soft); margin-bottom: 18px; }
  .pending-desc {
    font-size: 14.5px; color: var(--ink-soft); line-height: 1.85; margin-bottom: 26px;
  }
  .pending-desc b { color: var(--ink); }
  .pending-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .pending-actions a {
    padding: 11px 22px; border-radius: 8px; font-size: 14px;
    font-weight: 600; text-decoration: none;
  }
  .btn-primary { background: var(--cinnabar); color: #fff; }
  .btn-primary:hover { background: var(--cinnabar-deep); }
  .btn-secondary { border: 1.5px solid var(--line); color: var(--ink); }
  .btn-secondary:hover { background: var(--paper); }

  .pending-ready { border-top: 1px solid var(--line); margin-top: 28px; padding-top: 20px; }
  .pending-ready h4 { font-size: 14px; margin-bottom: 12px; color: var(--ink); }
  .pending-pills { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .pending-pill {
    font-size: 13px; padding: 5px 14px; border-radius: 20px; text-decoration: none;
    background: var(--paper); color: var(--ink); border: 1px solid var(--line);
  }
  .pending-pill:hover { border-color: var(--cinnabar); color: var(--cinnabar); }
  .pending-foot { margin-top: 22px; font-size: 12.5px; color: var(--ink-soft); }
  .pending-foot a { color: var(--cinnabar); }
</style>
