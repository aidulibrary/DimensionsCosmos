---
import '../styles/global.css';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { type Locale, DEFAULT_LOCALE, LOCALES, ACTIVE_LOCALES, href, localePath } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props {
  /** 页面语言；默认简体中文 */
  lang?: Locale;
  title?: string;
  description?: string;
  /** 站点内页/错误页设为 true，避免被搜索引擎收录 */
  noindex?: boolean;
  /** 纯功能页设为 true，隐藏导航中的定价/解锁等商业入口 */
  hideCommercial?: boolean;
}

const {
  title = '维点图书馆 · DimensionsCosmos Library',
  description = '伟大心智的阅读操作系统：用苏格拉底的方法读庄子，用费曼的方法读相对论，用朱熹的方法读古兰经。',
  noindex = false,
  hideCommercial = false,
  lang = DEFAULT_LOCALE,
} = Astro.props;

// ── 国际化上下文 ──
const meta = LOCALES[lang];
const t = ui[lang];
// 品牌名与标语：一律取自 ui 词典，禁止在此硬编码三元链
//（每新增一种语言都要回来改一次，是上一轮 B1 的遗留隐患，B2 一并消掉）
const brandName = t.brand;
const brandTag = t.tagline;
// 中英文混排标点与昼/夜字模：CJK 用汉字与全角标点，拉丁语系用拉丁字符
const isCJK = lang === 'zh' || lang === 'zh-TW';
const colon = isCJK ? '：' : ': ';
const dayMark = isCJK ? '昼' : lang === 'es' ? 'D' : 'L';
const nightMark = isCJK ? '夜' : lang === 'es' ? 'N' : 'D';
// 当前路径去掉语言前缀，供语言切换器换算出其他语言的同一页地址
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const curPrefix = meta.prefix;
const barePath = curPrefix && rawPath.startsWith(curPrefix) ? rawPath.slice(curPrefix.length) || '/' : rawPath;
const langLinks = ACTIVE_LOCALES.map((l) => ({ code: l, label: LOCALES[l].label, url: href(l, barePath), current: l === lang }));

// 保证尾斜杠，`${base}books` 才能拼成 `/books`
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

// ── 品牌标识几何（L0 母版，与 public/logo.svg 完全同源）──
// 由标识矢量母版导出：viewBox 569×735（比例 0.774），一次书写、四处复用
// （顶栏 .brand-mark / 页脚 .footer-mark），任何一处改几何都必须同步 /logo.svg，
// 否则就出现「感觉差不多的第二个图形」，那是品牌规范明令禁止的。
const MARK_VIEWBOX = '0 0 569 735';
const MARK_PATH =
  'M72 0 L495 0 L498 2 L503 2 L504 3 L512 5 L524 11 L535 19 L545 29 L547 33 L554 42 L561 57 L561 59 L563 63 L563 66 L564 67 L564 70 L565 71 L565 76 L566 77 L566 82 L567 83 L567 90 L568 91 L568 145 L566 145 L565 146 L497 146 L496 145 L496 100 L495 99 L494 92 L492 89 L492 87 L485 78 L478 73 L472 72 L468 70 L98 70 L94 72 L88 73 L82 77 L78 81 L75 87 L73 89 L72 95 L70 99 L70 488 L72 489 L82 482 L84 482 L89 479 L93 479 L96 477 L99 477 L104 475 L118 474 L123 472 L132 472 L132 540 L131 541 L126 541 L122 544 L118 544 L104 550 L98 554 L85 567 L81 573 L75 587 L75 591 L74 592 L74 596 L73 597 L73 610 L74 611 L74 615 L75 616 L75 620 L76 621 L77 626 L84 639 L91 647 L92 647 L102 656 L114 662 L123 664 L125 666 L130 666 L132 667 L132 720 L133 721 L133 730 L132 731 L132 733 L130 733 L129 734 L119 734 L118 733 L98 732 L97 731 L83 731 L76 728 L70 728 L67 726 L57 723 L53 720 L51 720 L39 713 L31 707 L25 701 L16 689 L14 684 L12 682 L10 677 L7 673 L7 671 L5 667 L5 662 L3 658 L2 650 L0 647 L0 74 L2 71 L2 67 L3 66 L5 58 L7 55 L7 53 L13 41 L16 38 L21 30 L32 19 L43 11 L51 7 L58 5 L61 3 L70 2ZM168 471h401v68h-401ZM167 571h402v66h-402ZM167 669h402v66h-402ZM385 392h184v46h-184ZM385 315h184v46h-184ZM167 392h183v46h-183ZM167 315h183v46h-183ZM385 236h184v46h-184ZM167 236h183v46h-183Z';

// 数据新鲜度：构建时读取 public/data/index.json 的 generatedAt，页脚展示。
// 用途：CI 的数据提交若失败，Cloudflare 会拿旧数据构建出"成功但内容陈旧"的站点，
// 页脚日期可让这种静默陈旧一眼可见。读取失败时静默降级，不影响构建。
let dataUpdated = '';
try {
  // 构建期 cwd 为项目根；另用模块路径兜底，避免不同构建器下 cwd 不一致
  const candidates = [
    path.join(process.cwd(), 'public', 'data', 'index.json'),
    path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../public/data/index.json'),
  ];
  const file = candidates.find((p) => fs.existsSync(p));
  const idx = file ? JSON.parse(fs.readFileSync(file, 'utf8')) : null;
  const d = new Date(idx?.generatedAt);
  if (!Number.isNaN(d.getTime())) {
    dataUpdated = new Intl.DateTimeFormat(meta.dateLocale, {
      timeZone: 'Asia/Shanghai',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).format(d);
  }
} catch (_) {
  /* 数据文件缺失或格式异常时静默降级 */
}
---

<!DOCTYPE html>
<html lang={meta.htmlLang} dir={meta.dir}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <!--
    夜间模式首帧判定：必须内联且放在 head 最前。
    放到 body 末尾或用外部脚本，都会先闪一帧米色纸底再变暗，深色下非常刺眼。
    优先级：用户手选 > 系统偏好。
  -->
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) { /* 隐私模式下 localStorage 可能抛错，按日间渲染 */ }
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description}>
  {/* hreflang：让 Google/Bing 知道这是一组等价页而非重复内容；x-default 指向默认语言 */}
  {langLinks.map((l) => (
    <link rel="alternate" hreflang={LOCALES[l.code].htmlLang} href={new URL(l.url, Astro.site ?? Astro.url).href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(href('zh', barePath), Astro.site ?? Astro.url).href} />
  {noindex && <meta name="robots" content="noindex, follow">}

  <!-- ══ PWA 基础 ══ -->
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#003048">
  <meta name="color-scheme" content="light dark">

  <!--
    商店模式探测（应用商店 / MSIX 包装 / 已安装的独立窗口）：
    命中后给 <html> 打上 store-mode 类，配合 global.css 隐藏一切站外付费语境，
    仅保留免费阅读内容，以满足 Microsoft Store 对数字内容结算的合规要求。
    普通浏览器访问（display-mode 为 browser）不受影响，网页端展示照常。
  -->
  <script is:inline>
    (function () {
      try {
        var mq = window.matchMedia && window.matchMedia('(display-mode: standalone)').matches;
        var ios = window.navigator.standalone === true;
        var forced = /(^|[?&])store=1(&|$)/.test(window.location.search);
        if (mq || ios || forced) document.documentElement.classList.add('store-mode');
      } catch (e) { /* 探测失败一律按网页模式处理，不隐藏任何内容 */ }
    })();
  </script>
  <meta name="application-name" content={brandName}>
  <meta name="format-detection" content="telephone=no">

  <!-- iOS 全屏与添加到主屏 -->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content={brandName}>

  <!-- 图标 -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon-180.png">

  <!-- ══ 社交分享 ══ -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={brandName}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={`${brandName} · ${brandTag}`}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="/og-image.png">

  <!--
    字体说明：原 Google Fonts 外链已移除。
    原因：googleapis 在国内不可达，且是渲染阻塞资源，会让首屏白等十几秒；
    装成 App 后离线更完全取不到。
    global.css 的字体栈为 "Noto Serif SC", "Songti SC", "STSong", "SimSun", serif，
    系统自带宋体自动接住，中文排版观感一致。
    将来若要恢复 Web 字体，请把子集化后的 woff2 自托管到 /fonts/ 并用 @font-face 引入。
  -->

  <style is:inline>
    /* 语言切换器：三个字的胶囊，当前语言反色。刻意不用下拉，避免多一次点击 */
    .lang-switch { display: inline-flex; gap: 2px; padding: 2px; border: 1px solid var(--line); border-radius: 999px; }
    .lang-switch a {
      font-size: 12px; line-height: 1; padding: 5px 9px; border-radius: 999px;
      color: var(--ink-soft); text-decoration: none; white-space: nowrap;
    }
    .lang-switch a:hover { color: var(--ink); }
    .lang-switch a.on { background: var(--surface-brand); color: var(--on-accent); }
    @media (max-width: 720px) { .lang-switch a { padding: 4px 7px; font-size: 11px; } }

    /* 站点顶栏高度：供各页 sticky 元素（目录、校勘栏、工具条）对齐 */
    :root {
      --nav-h: 82px;
    }

    /* 已安装为 App（独立窗口）时的安全区适配：避开刘海与底部手势条 */
    @supports (padding: env(safe-area-inset-bottom)) {
      body {
        padding-left: env(safe-area-inset-left);
        padding-right: env(safe-area-inset-right);
      }
      nav {
        padding-top: calc(14px + env(safe-area-inset-top));
      }
      footer {
        padding-bottom: calc(24px + env(safe-area-inset-bottom));
      }
    }

    /* 独立窗口：禁止整页回弹，避免阅读时误触 */
    @media (display-mode: standalone) {
      html {
        -webkit-text-size-adjust: 100%;
        overscroll-behavior-y: contain;
      }
    }
  </style>
</head>
<body>
  <nav>
    <a class="brand" href={base}>
      <svg
        class="brand-mark"
        viewBox={MARK_VIEWBOX}
        aria-hidden="true"
        focusable="false"
      >
        <path d={MARK_PATH} />
      </svg>
      <span><b>{t.brand}</b><small>DimensionsCosmos</small></span>
    </a>
    <div class="nav-links">
      <a href={href(lang, '/books')}>{t.nav.books}</a>
      <a href={href(lang, '/tasks')}>{t.nav.tasks}</a>
      <a href={href(lang, '/methods')}>{t.nav.methods}</a>
      {!hideCommercial && <a href={href(lang, '/pricing')} data-store-hide>{t.nav.pricing}</a>}
      {!hideCommercial && <a class="nav-cta" href={href(lang, '/pricing')} data-store-hide>{t.nav.cta}</a>}
      <div class="lang-switch" role="group" aria-label={t.a11y.langSwitch}>
        {langLinks.map((l) => (
          <a href={l.url} hreflang={LOCALES[l.code].htmlLang} class:list={[{ on: l.current }]}>{l.label}</a>
        ))}
      </div>
      <button
        class="theme-toggle"
        id="themeToggle"
        type="button"
        aria-label={t.a11y.themeToggle}
        data-day-text={dayMark}
        data-night-text={nightMark}
        data-to-dark={t.a11y.themeToDark}
        data-to-light={t.a11y.themeToLight}
      >{nightMark}</button>
    </div>
  </nav>
  <main>
    <slot />
  </main>
  <footer>
    <div class="footer-brand">
      <svg class="footer-mark" viewBox={MARK_VIEWBOX} aria-hidden="true" focusable="false">
        <path d={MARK_PATH} />
      </svg>
      <span class="footer-brand-name">
        <b>{t.brand}</b>
        <small>Dimensions Cosmos Library</small>
      </span>
    </div>
    <p>{t.footer.motto}</p>
    <p style="margin-top:4px">{t.footer.source}</p>
    <p style="margin-top:4px"><strong>{t.footer.aiNotice}</strong>{colon}{t.footer.aiNoticeDetail} <a href={href(lang, '/about')}>{t.footer.aiNoticeLink}</a></p>
    <p style="margin-top:4px">{t.footer.slogan} · v1.0 MVP · <a href="https://github.com/aidulibrary/DimensionsCosmos">GitHub</a></p>
    <p style="margin-top:4px">
      <a href={href(lang, '/about')}>{t.footer.about}</a> ·
      <a href={href(lang, '/terms')}>{t.footer.terms}</a> ·
      <a href={href(lang, '/refund')}>{t.footer.refund}</a> ·
      <a href={href(lang, '/privacy')}>{t.footer.privacy}</a>
    </p>
    {dataUpdated && <p style="margin-top:4px;opacity:.72">{t.footer.updated} {dataUpdated}{t.utcNote}</p>}
  </footer>

  <script is:inline>
    // 顶栏实际高度写入 --nav-h，供 sticky 定位（含安全区/换行自适应）
    (function () {
      var nav = document.querySelector('body > nav');
      if (!nav) return;
      function apply() {
        document.documentElement.style.setProperty('--nav-h', Math.round(nav.getBoundingClientRect().height) + 'px');
      }
      apply();
      window.addEventListener('resize', apply, { passive: true });
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(apply);
    })();
  </script>

  <script is:inline>
    // 语言切换要保留商店标记：MSIX 版从 /?store=1 切到 /en/ 时若无 ?store=1，
    // 会重新露出站外付费入口（display-mode 兜底仍在，这里做双保险）。
    (function () {
      try {
        if (!/(^|[?&])store=1(&|$)/.test(location.search)) return;
        document.querySelectorAll('.lang-switch a').forEach(function (a) {
          var u = new URL(a.getAttribute('href'), location.origin);
          u.searchParams.set('store', '1');
          a.setAttribute('href', u.pathname + u.search);
        });
      } catch (e) { /* 失败按普通网页处理 */ }
    })();
  </script>

  <script is:inline>
    // 夜间模式切换：只改 <html data-theme>，配色全部由 global.css 的 token 承载
    (function () {
      var d = document.documentElement;
      var btn = document.getElementById('themeToggle');
      function sync() {
        var dark = d.getAttribute('data-theme') === 'dark';
        if (btn) {
          btn.textContent = dark ? (btn.dataset.dayText || '昼') : (btn.dataset.nightText || '夜');
          btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
          btn.setAttribute('aria-label', dark ? (btn.dataset.toLight || '切换到日间模式') : (btn.dataset.toDark || '切换到夜间模式'));
        }
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', dark ? '#0E1A22' : '#003048');
      }
      if (btn) {
        btn.addEventListener('click', function () {
          var next = d.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          d.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          sync();
        });
      }
      sync();
      // 用户没手选过时跟随系统切换
      if (window.matchMedia) {
        try {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
            var saved = null;
            try { saved = localStorage.getItem('theme'); } catch (err) {}
            if (saved) return;
            d.setAttribute('data-theme', e.matches ? 'dark' : 'light');
            sync();
          });
        } catch (e) { /* 老浏览器不支持 addEventListener，忽略 */ }
      }
    })();
  </script>

  <script is:inline>
    // Service Worker 注册：等页面加载完再注册，不抢首屏带宽
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(function (err) {
          console.warn('[PWA] Service Worker 注册失败：', err);
        });
      });
    }
  </script>
</body>
</html>
