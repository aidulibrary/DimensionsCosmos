{
  "name": "dimensions-cosmos",
  "version": "1.0.0",
  "type": "module",
  "description": "维点图书馆 / DimensionsCosmos Library —— 古籍 AI 导读引擎",
  "private": true,
  "scripts": {
    "gen": "node --experimental-sqlite scripts/gen-data.mjs",
    "prebuild": "node scripts/gen.mjs && node scripts/check-i18n-coverage.mjs",
    "predev": "node scripts/gen.mjs && node scripts/check-i18n-coverage.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/postbuild-ref-routes.mjs && node scripts/postbuild-seo.mjs",
    "preview": "astro preview",
    "test:ref": "node scripts/test-ref-resolver.mjs",
    "citations": "python scripts/migrate_citations.py",
    "citations:apply": "python scripts/migrate_citations.py --apply",
    "citations:verify": "python scripts/migrate_citations.py --verify",
    "guides:cited": "python pipeline/gen_guides_cited.py",
    "guides:dry": "python pipeline/gen_guides_cited.py --work-id 1 --method zhuxi --dry-run",
    "check:i18n": "node scripts/check-i18n-coverage.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "astro": "^7.3.3",
    "typescript": "^7.0.2"
  }
}
